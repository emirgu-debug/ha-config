                      "custom_fields": {
                        "c": "[[[\n  // --- colour helpers ---------------------------------------------------\n  const k2rgb = (k) => { const t = k / 100; let r, g, b;\n    if (t <= 66) { r = 255; g = 99.47 * Math.log(t) - 161.12; }\n    else { r = 329.7 * Math.pow(t - 60, -0.1332); g = 288.12 * Math.pow(t - 60, -0.0755); }\n    if (t >= 66) b = 255; else if (t <= 19) b = 0; else b = 138.52 * Math.log(t - 10) - 305.04;\n    const q = (v) => Math.max(0, Math.min(255, Math.round(v)));\n    return [q(r), q(g), q(b)]; };\n\n  const TUNGSTEN = [255, 176, 92];        // plain on/off relays — warm bulb\n  const LIGHTS = [[\"switch.giris_aydinlatma_dolap_ayna_l1\",52,47,17,\"ceil\"],[\"switch.giris_aydinlatma_dolap_ayna_l2\",65,52,17,\"ceil\"],[\"switch.giris_aydinlatma_sanat_sokak_l1\",55,56,17,\"ceil\"],[\"switch.giris_aydinlatma_sanat_sokak_l2\",54,58,17,\"ceil\"],[\"switch.tv_aydinlatma_l1\",50,74,19,\"ceil\"],[\"switch.tv_aydinlatma_l2\",50,87,19,\"ceil\"],[\"switch.salon_aydinlatma_l1\",62,65,22,\"ceil\"],[\"switch.salon_aydinlatma_l2\",75,90,22,\"ceil\"],[\"light.leyla_huespot_sol\",37,79,11,\"spot\"],[\"light.leyla_huespot_sag\",37,82,11,\"spot\"],[\"light.tv_dixon_hue\",44,91,14,\"lamp\"],[\"light.bitki_hasir_hue\",90,92,14,\"lamp\"],[\"light.beyaz_aplik_hue\",98,83,15,\"lamp\"],[\"light.kartel_salon\",95,49,13,\"lamp\"],[\"light.tv_yer\",56,91,14,\"lamp\"],[\"light.salon_calisma_masasi\",69,91,11,\"lamp\"],[\"light.oda_kartel\",4,74,13,\"lamp\"],[\"switch.koridor_aydinlatma\",40,61,15,\"ceil\"],[\"switch.camasir_aydinlatma\",52,66,13,\"ceil\"],[\"switch.is_odasi_aydinlatma\",16,46,17,\"ceil\"],[\"switch.is_odasi_giris_aydinlatma\",39,47,13,\"ceil\"],[\"switch.mutfak_aydinlatma_l1\",77,41,12,\"lamp\"],[\"switch.mutfak_aydinlatma_l2\",77,33,13,\"ceil\"]];\n\n  let lit = 0, total = 0, blobs = '';\n\n  for (const [id, left, top, rad, kind] of LIGHTS) {\n    const s = states[id];\n    total++;\n    if (!s || s.state !== 'on') continue;     // off or unavailable -> no glow\n    lit++;\n\n    // brightness 0..1 (relays have none, so treat as full)\n    const br = s.attributes.brightness != null ? s.attributes.brightness / 255 : 1;\n\n    // colour: real rgb if the bulb is in a colour mode, else its kelvin, else tungsten\n    let rgb = TUNGSTEN;\n    if (s.attributes.rgb_color) rgb = s.attributes.rgb_color;\n    else if (s.attributes.color_temp_kelvin) rgb = k2rgb(s.attributes.color_temp_kelvin);\n\n    // dim bulbs make a smaller, softer pool of light (narrowed vs. the original build)\n    const size = rad * (0.46 + 0.40 * br);\n    const core = (0.30 + 0.55 * br).toFixed(2);\n    const mid  = (0.12 + 0.28 * br).toFixed(2);\n    const c = rgb.join(',');\n\n    blobs += '<i class=\"gl\" style=\"left:' + left + '%;top:' + top + '%;'\n      + 'width:' + (size * 2).toFixed(1) + '%;height:' + (size * 2).toFixed(1) + '%;'\n      + 'background:radial-gradient(circle,rgba(' + c + ',' + core + ') 0%,'\n      + 'rgba(' + c + ',' + mid + ') 38%,rgba(' + c + ',0) 72%)\"></i>';\n\n    // a tight, brighter reflection core — the direct glint of the bulb, not just its wash\n    const rsize = rad * (0.16 + 0.10 * br);\n    const rcore = (0.55 + 0.35 * br).toFixed(2);\n    blobs += '<i class=\"rf\" style=\"left:' + left + '%;top:' + top + '%;'\n      + 'width:' + (rsize * 2).toFixed(1) + '%;height:' + (rsize * 2).toFixed(1) + '%;'\n      + 'background:radial-gradient(circle,rgba(' + c + ',' + rcore + ') 0%,rgba(' + c + ',0) 70%)\"></i>';\n  }\n\n  // the room goes dark when nothing is on, and lifts as lights come up\n  const veil = (0.62 * (1 - lit / Math.max(1, total)) ** 0.7).toFixed(3);\n  return '<div class=\"veil\" style=\"opacity:' + veil + '\"></div>' + blobs;\n]]]"
