{
  "version": 1,
  "minor_version": 1,
  "key": "lovelace.sky_home",
  "data": {
    "config": {
      "title": "Sky & Home",
      "button_card_templates": {
        "sky_base": {
          "variables": {
            "astro_lib": "// Low-precision astronomy (Meeus / Schlyter style). ~0.3° Moon, ~1° planets. Returns an object of helpers.\nconst R = Math.PI / 180, D = 180 / Math.PI;\nconst norm = (x) => ((x % 360) + 360) % 360;\nconst sin = (x) => Math.sin(x * R), cos = (x) => Math.cos(x * R);\nconst jd = (t) => t / 86400000 + 2440587.5;              // t = ms epoch\nconst dn = (t) => jd(t) - 2451545.0;                      // days since J2000\nconst obl = (t) => 23.439 - 0.0000004 * dn(t);\nfunction sunLon(t) {\n  const n = dn(t), L = norm(280.460 + 0.9856474 * n), g = norm(357.528 + 0.9856003 * n);\n  return norm(L + 1.915 * sin(g) + 0.020 * sin(2 * g));\n}\nfunction moonEcl(t) {\n  const n = dn(t);\n  const Lp = norm(218.316 + 13.176396 * n), Mp = norm(134.963 + 13.064993 * n), F = norm(93.272 + 13.229350 * n);\n  const Dm = norm(297.850 + 12.190749 * n), M = norm(357.528 + 0.9856003 * n);\n  const lon = Lp + 6.289 * sin(Mp) + 1.274 * sin(2 * Dm - Mp) + 0.658 * sin(2 * Dm) - 0.186 * sin(M)\n    - 0.059 * sin(2 * Mp - 2 * Dm) - 0.057 * sin(Mp - 2 * Dm + M) + 0.053 * sin(Mp + 2 * Dm)\n    + 0.046 * sin(2 * Dm - M) + 0.041 * sin(Mp - M) - 0.035 * sin(Dm) - 0.031 * sin(Mp + M) - 0.015 * sin(2 * F - 2 * Dm)\n    + 0.011 * sin(Mp - 4 * Dm);\n  const lat = 5.128 * sin(F) + 0.281 * sin(Mp + F) - 0.278 * sin(F - Mp) - 0.173 * sin(F - 2 * Dm);\n  return { lon: norm(lon), lat };\n}\nconst elong = (t) => norm(moonEcl(t).lon - sunLon(t));   // 0 new, 180 full\nfunction phase(t) {\n  const e = elong(t);\n  return { elong: e, illum: (1 - cos(e)) / 2, waxing: e < 180, age: e / 360 * 29.530589 };\n}\nfunction phaseName(e) {\n  if (e < 6 || e > 354) return 'New Moon';\n  if (e < 84) return 'Waxing Crescent';\n  if (e < 96) return 'First Quarter';\n  if (e < 174) return 'Waxing Gibbous';\n  if (e < 186) return 'Full Moon';\n  if (e < 264) return 'Waning Gibbous';\n  if (e < 276) return 'Last Quarter';\n  return 'Waning Crescent';\n}\n// next time elongation reaches target (0 = new, 180 = full), bisection on hourly scan\nfunction nextPhase(t, target) {\n  const f = (x) => norm(elong(x) - target + 180) - 180;   // signed distance, crosses 0 upward\n  let a = t, fa = f(a);\n  for (let h = 1; h < 24 * 32; h++) {\n    const b = t + h * 3600e3, fb = f(b);\n    if (fa < 0 && fb >= 0 && fb - fa < 90) {\n      let lo = a, hi = b;\n      for (let i = 0; i < 30; i++) { const m = (lo + hi) / 2; if (f(m) < 0) lo = m; else hi = m; }\n      return hi;\n    }\n    a = b; fa = fb;\n  }\n  return null;\n}\nconst SIGNS = [['Aries', '♈︎'], ['Taurus', '♉︎'], ['Gemini', '♊︎'], ['Cancer', '♋︎'], ['Leo', '♌︎'], ['Virgo', '♍︎'],\n  ['Libra', '♎︎'], ['Scorpio', '♏︎'], ['Sagittarius', '♐︎'], ['Capricorn', '♑︎'], ['Aquarius', '♒︎'], ['Pisces', '♓︎']];\nconst sign = (lon) => { const i = Math.floor(norm(lon) / 30); return { i, name: SIGNS[i][0], sym: SIGNS[i][1], deg: norm(lon) - i * 30 }; };\n// equatorial -> horizontal\nfunction gmst(t) { return norm(280.46061837 + 360.98564736629 * dn(t)); }\nfunction eclToEq(lon, lat, t) {\n  const e = obl(t);\n  const ra = Math.atan2(sin(lon) * cos(e) - Math.tan(lat * R) * sin(e), cos(lon)) * D;\n  const dec = Math.asin(sin(lat) * cos(e) + cos(lat) * sin(e) * sin(lon)) * D;\n  return { ra: norm(ra), dec };\n}\nfunction eqToHor(ra, dec, t, latG, lonG) {\n  const H = norm(gmst(t) + lonG - ra);\n  const alt = Math.asin(sin(latG) * sin(dec) + cos(latG) * cos(dec) * cos(H)) * D;\n  const az = norm(Math.atan2(-sin(H) * cos(dec), cos(latG) * sin(dec) - sin(latG) * cos(dec) * cos(H)) * D);\n  return { alt, az };\n}\nfunction sunHor(t, la, lo) { const q = eclToEq(sunLon(t), 0, t); return eqToHor(q.ra, q.dec, t, la, lo); }\nfunction moonHor(t, la, lo) { const m = moonEcl(t); const q = eclToEq(m.lon, m.lat, t); return eqToHor(q.ra, q.dec, t, la, lo); }\n// sample the day: sun altitude every 5 min from local midnight; find crossings\nfunction sunDay(t, la, lo) {\n  const d = new Date(t); d.setHours(0, 0, 0, 0); const t0 = d.getTime();\n  const pts = []; for (let m = 0; m <= 1440; m += 5) { const x = t0 + m * 60e3; pts.push([x, sunHor(x, la, lo).alt]); }\n  const cross = (lvl, up) => { for (let i = 1; i < pts.length; i++) { const [xa, a] = pts[i - 1], [xb, b] = pts[i];\n    if (up ? (a < lvl && b >= lvl) : (a >= lvl && b < lvl)) return xa + (lvl - a) / (b - a) * (xb - xa); } return null; };\n  const maxP = pts.reduce((m, p) => p[1] > m[1] ? p : m);\n  return { t0, pts, rise: cross(-0.833, true), set: cross(-0.833, false), noon: maxP[0], maxAlt: maxP[1],\n    goldAmEnd: cross(6, true), goldPmStart: cross(6, false), blueAmStart: cross(-6, true), bluePmEnd: cross(-6, false),\n    blueAmEnd: cross(-4, true), bluePmStart: cross(-4, false) };\n}\n// planets: approximate Keplerian elements (Standish, valid 1800–2050). [a, e, I, L, varpi, Omega] + rates per century\nconst EL = {\n  Mercury: [[0.38709927, 0.20563593, 7.00497902, 252.25032350, 77.45779628, 48.33076593], [0.00000037, 0.00001906, -0.00594749, 149472.67411175, 0.16047689, -0.12534081]],\n  Venus: [[0.72333566, 0.00677672, 3.39467605, 181.97909950, 131.60246718, 76.67984255], [0.00000390, -0.00004107, -0.00078890, 58517.81538729, 0.00268329, -0.27769418]],\n  Earth: [[1.00000261, 0.01671123, -0.00001531, 100.46457166, 102.93768193, 0.0], [0.00000562, -0.00004392, -0.01294668, 35999.37244981, 0.32327364, 0.0]],\n  Mars: [[1.52371034, 0.09339410, 1.84969142, -4.55343205, -23.94362959, 49.55953891], [0.00001847, 0.00007882, -0.00813131, 19140.30268499, 0.44441088, -0.29257343]],\n  Jupiter: [[5.20288700, 0.04838624, 1.30439695, 34.39644051, 14.72847983, 100.47390909], [-0.00011607, -0.00013253, -0.00183714, 3034.74612775, 0.21252668, 0.20469106]],\n  Saturn: [[9.53667594, 0.05386179, 2.48599187, 49.95424423, 92.59887831, 113.66242448], [-0.00125060, -0.00050991, 0.00193609, 1222.49362201, -0.41897216, -0.28867794]],\n};\nfunction helio(name, t) {\n  const T = dn(t) / 36525, [e0, r] = EL[name];\n  const a = e0[0] + r[0] * T, e = e0[1] + r[1] * T, I = e0[2] + r[2] * T, L = e0[3] + r[3] * T, wb = e0[4] + r[4] * T, Om = e0[5] + r[5] * T;\n  const w = wb - Om; let M = norm(L - wb); if (M > 180) M -= 360;\n  let E = M + e * D * sin(M); for (let k = 0; k < 8; k++) E = E - (E - M - e * D * sin(E)) / (1 - e * cos(E));\n  const xp = a * (cos(E) - e), yp = a * Math.sqrt(1 - e * e) * sin(E);\n  const x = (cos(w) * cos(Om) - sin(w) * sin(Om) * cos(I)) * xp + (-sin(w) * cos(Om) - cos(w) * sin(Om) * cos(I)) * yp;\n  const y = (cos(w) * sin(Om) + sin(w) * cos(Om) * cos(I)) * xp + (-sin(w) * sin(Om) + cos(w) * cos(Om) * cos(I)) * yp;\n  const z = (sin(w) * sin(I)) * xp + (cos(w) * sin(I)) * yp;\n  return [x, y, z];\n}\nfunction planetEcl(name, t) {\n  const p = helio(name, t), E = helio('Earth', t);\n  const x = p[0] - E[0], y = p[1] - E[1], z = p[2] - E[2];\n  return { lon: norm(Math.atan2(y, x) * D), lat: Math.atan2(z, Math.hypot(x, y)) * D };\n}\nfunction planetHor(name, t, la, lo) { const g = planetEcl(name, t); const q = eclToEq(g.lon, g.lat, t); return { ...eqToHor(q.ra, q.dec, t, la, lo), lon: g.lon }; }\n// Verified windows (moontracks.com + astrologyzone.com; eclipses: eclipsewise.com + britannica.com)\nconst MERC_RX = [['2026-02-25', '2026-03-20'], ['2026-06-29', '2026-07-23'], ['2026-10-24', '2026-11-13'],\n  ['2027-02-09', '2027-03-03'], ['2027-06-10', '2027-07-04'], ['2027-10-07', '2027-10-28']];\nconst ECLIPSES = [['2026-02-17', 'Annular solar'], ['2026-03-03', 'Total lunar'], ['2026-08-12', 'Total solar'], ['2026-08-28', 'Partial lunar'],\n  ['2027-02-06', 'Annular solar'], ['2027-02-20', 'Penumbral lunar'], ['2027-07-18', 'Penumbral lunar'], ['2027-08-02', 'Total solar'], ['2027-08-17', 'Penumbral lunar']];\nreturn { norm, jd, sunLon, moonEcl, elong, phase, phaseName, nextPhase, sign, SIGNS, eclToEq, eqToHor, sunHor, moonHor, sunDay, planetEcl, planetHor, gmst, MERC_RX, ECLIPSES };\n",
            "sky": {
