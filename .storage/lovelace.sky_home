          ],
          "entity": "sun.sun",
          "styles": {
            "card": [
              {
                "background": "linear-gradient(165deg, #1b2030 0%, #12151f 100%)"
              },
              {
                "border": "none"
              },
              {
                "border-radius": "22px"
              },
              {
                "padding": "16px 16px 14px"
              },
              {
                "box-shadow": "0 12px 34px -16px rgba(0,0,0,.7)"
              },
              {
                "font-family": "'Nunito', 'Roboto', sans-serif"
              },
              {
                "color": "#e9ecf3"
              },
              {
                "text-align": "left"
              }
            ],
            "grid": [
              {
                "grid-template-areas": "\"c\""
              },
              {
                "grid-template-columns": "1fr"
              }
            ],
            "custom_fields": {
              "c": [
                {
                  "min-width": "0"
                },
                {
                  "text-align": "left"
                },
                {
                  "justify-self": "stretch"
                },
                {
                  "width": "100%"
                }
              ]
            }
          },
          "extra_styles": "\n    .ttl { font-size: 22px; font-weight: 800; color: #f1f4fb; letter-spacing: .2px; }\n    .sub { font-size: 12.5px; font-weight: 700; color: #9aa3b8; margin-top: 2px; }\n    .top { display:flex; justify-content: space-between; align-items: flex-end; gap: 10px; flex-wrap: wrap; margin-bottom: 6px; }\n    .rows { display:flex; flex-direction:column; gap: 7px; margin-top: 10px; }\n    .row { display:flex; justify-content: space-between; align-items: baseline; gap: 10px; font-size: 13.5px; }\n    .row .k { color: #8e97ac; font-weight: 700; font-size: 11px; letter-spacing: 1.1px; text-transform: uppercase; white-space: nowrap; }\n    .row .v { font-weight: 800; text-align: right; } .row .x { display: block; color: #9aa3b8; font-weight: 700; font-size: 11.5px; }\n    .chip { display:inline-block; padding: 2px 8px; border-radius: 99px; font-size: 11px; font-weight: 800; letter-spacing: .6px; }\n    .chip.ok { background: rgba(142,224,92,.16); color: #a6ea7c; } .chip.bad { background: rgba(224,119,111,.18); color: #ffab9f; animation: pulse 2.4s ease-in-out infinite; }\n    @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: .55; } }\n    @keyframes twk { 0%,100% { opacity: 1; } 50% { opacity: .45; } }\n    @keyframes breathe { 0%,100% { transform: scale(1); opacity: .9; } 50% { transform: scale(1.15); opacity: 1; } }\n    @media (prefers-reduced-motion: reduce) { * { animation: none !important; } }"
        },
        "home_base": {
          "show_icon": false,
          "show_name": false,
          "show_state": false,
          "tap_action": {
            "action": "more-info"
          },
          "hold_action": {
            "action": "none"
          },
          "styles": {
            "card": [
              {
                "background": "linear-gradient(165deg, #1d2226 0%, #131618 100%)"
              },
              {
                "border": "none"
              },
              {
                "border-radius": "22px"
              },
              {
                "padding": "14px 16px"
              },
              {
                "box-shadow": "0 12px 34px -16px rgba(0,0,0,.7)"
              },
              {
                "font-family": "'Nunito', 'Roboto', sans-serif"
              },
              {
                "color": "#e9ecf3"
              },
              {
                "text-align": "left"
              },
              {
                "height": "100%"
              }
            ],
            "grid": [
              {
                "grid-template-areas": "\"c\""
              },
              {
                "grid-template-columns": "1fr"
              }
            ],
            "custom_fields": {
              "c": [
                {
                  "min-width": "0"
                },
                {
                  "text-align": "left"
                },
                {
                  "justify-self": "stretch"
                },
                {
                  "width": "100%"
                }
              ]
            }
          },
          "extra_styles": "\n    .hd { display:flex; align-items:center; gap: 8px; margin-bottom: 10px; } .hd ha-icon { --mdc-icon-size: 20px; color: #8ee05c; }\n    .hn { font-size: 18px; font-weight: 800; flex: 1; }\n    .chip { display:inline-block; padding: 3px 9px; border-radius: 99px; font-size: 11px; font-weight: 800; letter-spacing: .5px; background: rgba(255,255,255,.07); color: #aeb6c6; }\n    .chip.on { background: rgba(111,208,242,.16); color: #9fe2ff; } .chip.ok { background: rgba(142,224,92,.15); color: #a6ea7c; }\n    .chip.bad { background: rgba(224,119,111,.18); color: #ffab9f; animation: pulse 2s ease-in-out infinite; } .chip.warn { background: rgba(231,183,95,.16); color: #f1cf8d; }\n    .meta { font-size: 12px; color: #8e97ac; font-weight: 700; margin-top: 8px; text-align: center; } .meta b { color: #fff; }\n    .tanks { display:flex; justify-content: center; gap: 14px; margin-top: 12px; } .tanks.wrap { flex-wrap: wrap; gap: 12px 14px; } .tanks.one { margin-top: 8px; }\n    .tk { display:flex; flex-direction: column; align-items: center; gap: 4px; }\n    .tank { position: relative; width: 46px; height: 62px; border-radius: 13px; overflow: hidden; background: rgba(255,255,255,.05); box-shadow: inset 0 0 0 1.5px rgba(255,255,255,.1); }\n    .liq { position:absolute; left:0; right:0; bottom:0; background: var(--c); opacity: .85; transition: height 1.2s ease; }\n    .liq::before { content:''; position:absolute; left:0; top:-6px; width: 200%; height: 7px;\n      background: radial-gradient(circle at 8px 7px, var(--c) 6px, transparent 6.5px) repeat-x; background-size: 16px 7px; animation: wave 2.4s linear infinite; }\n    @keyframes wave { from { transform: translateX(0); } to { transform: translateX(-50%); } }\n    .tv { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-size: 12px; font-weight: 800; color: #fff; text-shadow: 0 1px 4px rgba(0,0,0,.6); }\n    .tl { font-size: 11px; font-weight: 800; color: #c9d0dc; } .ts { font-size: 10px; color: #8ee05c; font-weight: 800; }\n    .ring { position:absolute; inset:0; width:100%; height:100%; } .ring .rt { fill:none; stroke: rgba(255,255,255,.07); stroke-width: 6; }\n    .ring .rp { fill:none; stroke: #6fd0f2; stroke-width: 6; stroke-linecap: round; transition: stroke-dasharray 1s; }\n    @keyframes spin { to { transform: rotate(360deg); } }\n    @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: .55; } }\n    @media (prefers-reduced-motion: reduce) { * { animation: none !important; } }"
        }
      },
      "views": [
        {
          "title": "Sky",
          "path": "sky",
          "icon": "mdi:weather-night",
          "type": "sections",
          "max_columns": 3,
          "background": "radial-gradient(ellipse at 20% -10%, #1a2240 0%, #0d1020 55%, #080a14 100%)",
          "sections": [
            {
              "type": "grid",
              "column_span": 2,
              "cards": [
                {
                  "type": "custom:button-card",
                  "template": "sky_base",
                  "custom_fields": {
                    "c": "[[[ \n  \n  const A = window.__astroLib || (window.__astroLib = new Function(variables.astro_lib)());\n  const TZ = hass.config.time_zone || 'Europe/Istanbul';\n  const fmtT = (t) => t ? new Date(t).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: TZ }) : '—';\n  const fmtD = (t) => new Date(t).toLocaleDateString('en-US', { day: 'numeric', month: 'short', timeZone: TZ });\n  const fmtDW = (t) => new Date(t).toLocaleDateString('en-US', { weekday: 'short', day: 'numeric', month: 'short', timeZone: TZ });\n  const inDays = (t) => { const d = Math.round((t - Date.now()) / 86400000); return d <= 0 ? 'today' : (d === 1 ? 'tomorrow' : 'in ' + d + ' days'); };\n  const LA = hass.config.latitude, LO = hass.config.longitude;\n\n  const now = Date.now(), d = A.sunDay(now, LA, LO);\n  const W = 640, H = 210, X0 = 18, X1 = W - 18, Ymax = 75, Ymin = -25;\n  const X = (t) => X0 + (t - d.t0) / 86400000 * (X1 - X0), Y = (a) => 14 + (Ymax - a) / (Ymax - Ymin) * (H - 44);\n  const path = (pts) => pts.map((p, i) => (i ? 'L' : 'M') + X(p[0]).toFixed(1) + ' ' + Y(p[1]).toFixed(1)).join(' ');\n  const mpts = []; for (let m = 0; m <= 1440; m += 10) { const t = d.t0 + m * 60e3; mpts.push([t, A.moonHor(t, LA, LO).alt]); }\n  const sunNow = A.sunHor(now, LA, LO), moonNow = A.moonHor(now, LA, LO);\n  const ph = A.phase(now);\n  // golden / blue bands along the sun curve\n  const band = (lo, hi, col) => { let s = '', seg = []; for (const p of d.pts) { if (p[1] >= lo && p[1] < hi) seg.push(p); else if (seg.length) { s += '<path d=\"' + path(seg) + '\" stroke=\"' + col + '\" stroke-width=\"7\" fill=\"none\" stroke-linecap=\"round\" opacity=\".9\"/>'; seg = []; } }\n    if (seg.length) s += '<path d=\"' + path(seg) + '\" stroke=\"' + col + '\" stroke-width=\"7\" fill=\"none\" stroke-linecap=\"round\" opacity=\".9\"/>'; return s; };\n  const hours = [0, 6, 12, 18, 24].map(h => '<text x=\"' + (X0 + h / 24 * (X1 - X0)).toFixed(1) + '\" y=\"' + (H - 6) + '\" class=\"ax\">' + String(h % 24).padStart(2, '0') + ':00</text>').join('');\n  const nx = X(now).toFixed(1);\n  const up = sunNow.alt > -0.833;\n  let status;\n  if (up) status = 'Sun sets ' + fmtT(d.set) + ' · ' + Math.max(0, Math.round((d.set - now) / 60000 / 60 * 10) / 10) + ' h of light left';\n  else { const tr = d.rise && d.rise > now ? d.rise : A.sunDay(now + 86400000, LA, LO).rise; status = 'Sunrise ' + fmtT(tr) + ' · in ' + Math.round((tr - now) / 3600000 * 10) / 10 + ' h'; }\n  const dayLen = (d.set && d.rise) ? ((d.set - d.rise) / 3600000) : 0;\n  const svg = '<svg viewBox=\"0 0 ' + W + ' ' + H + '\" class=\"hz\">'\n    + '<defs><linearGradient id=\"gnd\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\"><stop offset=\"0\" stop-color=\"rgba(0,0,0,.0)\"/><stop offset=\"1\" stop-color=\"rgba(0,0,0,.45)\"/></linearGradient>'\n    + '<radialGradient id=\"sg\"><stop offset=\"0\" stop-color=\"#fff6d0\"/><stop offset=\".45\" stop-color=\"#ffd27a\"/><stop offset=\"1\" stop-color=\"rgba(255,190,90,0)\"/></radialGradient></defs>'\n    + '<rect x=\"0\" y=\"' + Y(0) + '\" width=\"' + W + '\" height=\"' + (H - Y(0)) + '\" fill=\"url(#gnd)\"/>'\n    + '<line x1=\"' + X0 + '\" x2=\"' + X1 + '\" y1=\"' + Y(0) + '\" y2=\"' + Y(0) + '\" class=\"hl\"/>'\n    + '<path d=\"' + path(mpts) + '\" class=\"mc\"/>'\n    + '<path d=\"' + path(d.pts) + '\" class=\"sc\"/>'\n    + band(-6, -4, '#6c8cff') + band(-4, 6, '#ffae5c')\n    + '<line x1=\"' + nx + '\" x2=\"' + nx + '\" y1=\"10\" y2=\"' + (H - 22) + '\" class=\"now\"/>'\n    + '<circle cx=\"' + nx + '\" cy=\"' + Y(moonNow.alt).toFixed(1) + '\" r=\"6\" class=\"mo\"/>'\n    + '<circle cx=\"' + nx + '\" cy=\"' + Y(sunNow.alt).toFixed(1) + '\" r=\"18\" fill=\"url(#sg)\" class=\"sunhalo\"/>'\n    + '<circle cx=\"' + nx + '\" cy=\"' + Y(sunNow.alt).toFixed(1) + '\" r=\"7\" class=\"sun ' + (up ? '' : 'down') + '\"/>'\n    + hours + '</svg>';\n  const cell = (k, v) => '<div class=\"cell\"><div class=\"k\">' + k + '</div><div class=\"v\">' + v + '</div></div>';\n  return '<div class=\"top\"><div><div class=\"ttl\">Today’s sky</div><div class=\"sub\">' + status + '</div></div>'\n    + '<div class=\"alt\">SUN <b>' + sunNow.alt.toFixed(0) + '°</b> · MOON <b>' + moonNow.alt.toFixed(0) + '°</b></div></div>' + svg\n    + '<div class=\"grid\">' + cell('Blue hour', fmtT(d.blueAmStart) + '–' + fmtT(d.blueAmEnd)) + cell('Sunrise', fmtT(d.rise)) + cell('Golden hour', fmtT(d.goldPmStart) + '–' + fmtT(d.set))\n    + cell('Sunset', fmtT(d.set)) + cell('Blue hour', fmtT(d.bluePmStart) + '–' + fmtT(d.bluePmEnd)) + cell('Daylight', Math.floor(dayLen) + 'h ' + Math.round((dayLen % 1) * 60) + 'm') + '</div>'\n    + '<div class=\"legend\"><span><i class=\"lg s\"></i>Sun</span><span><i class=\"lg m\"></i>Moon</span><span><i class=\"lg g\"></i>Golden</span><span><i class=\"lg b\"></i>Blue</span></div>';\n ]]]"
                  },
                  "grid_options": {
                    "columns": "full"
                  },
                  "extra_styles": "\n    .ttl { font-size: 22px; font-weight: 800; color: #f1f4fb; letter-spacing: .2px; }\n    .sub { font-size: 12.5px; font-weight: 700; color: #9aa3b8; margin-top: 2px; }\n    .top { display:flex; justify-content: space-between; align-items: flex-end; gap: 10px; flex-wrap: wrap; margin-bottom: 6px; }\n    .rows { display:flex; flex-direction:column; gap: 7px; margin-top: 10px; }\n    .row { display:flex; justify-content: space-between; align-items: baseline; gap: 10px; font-size: 13.5px; }\n    .row .k { color: #8e97ac; font-weight: 700; font-size: 11px; letter-spacing: 1.1px; text-transform: uppercase; white-space: nowrap; }\n    .row .v { font-weight: 800; text-align: right; } .row .x { display: block; color: #9aa3b8; font-weight: 700; font-size: 11.5px; }\n    .chip { display:inline-block; padding: 2px 8px; border-radius: 99px; font-size: 11px; font-weight: 800; letter-spacing: .6px; }\n    .chip.ok { background: rgba(142,224,92,.16); color: #a6ea7c; } .chip.bad { background: rgba(224,119,111,.18); color: #ffab9f; animation: pulse 2.4s ease-in-out infinite; }\n    @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: .55; } }\n    @keyframes twk { 0%,100% { opacity: 1; } 50% { opacity: .45; } }\n    @keyframes breathe { 0%,100% { transform: scale(1); opacity: .9; } 50% { transform: scale(1.15); opacity: 1; } }\n    @media (prefers-reduced-motion: reduce) { * { animation: none !important; } }\n  .hz { width: 100%; height: auto; display: block; margin-top: 4px; overflow: visible; }\n  .hz .hl { stroke: rgba(255,255,255,.35); stroke-width: 1; stroke-dasharray: 3 4; }\n  .hz .sc { stroke: #ffd27a; stroke-width: 2.4; fill: none; opacity: .85; }\n  .hz .mc { stroke: #cfd6e6; stroke-width: 1.6; fill: none; stroke-dasharray: 4 5; opacity: .55; }\n  .hz .now { stroke: rgba(255,255,255,.28); stroke-width: 1; }\n  .hz .sun { fill: #fff2c2; } .hz .sun.down { fill: #7a6a4a; }\n  .hz .sunhalo { transform-box: fill-box; transform-origin: center; animation: breathe 5s ease-in-out infinite; }\n  .hz .mo { fill: #e8e6dc; stroke: #12151f; stroke-width: 2; }\n  .hz .ax { fill: #7d869c; font-size: 11px; font-weight: 700; text-anchor: middle; font-family: 'Nunito', 'Roboto', sans-serif; }\n  .alt { font-size: 12px; font-weight: 700; color: #9aa3b8; letter-spacing: .8px; } .alt b { color: #fff; }\n  .grid { display:grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 8px; }\n  .cell { background: rgba(255,255,255,.04); border-radius: 12px; padding: 7px 10px; }\n  .cell .k { font-size: 10px; font-weight: 800; letter-spacing: 1.1px; color: #8e97ac; text-transform: uppercase; } .cell .v { font-size: 15px; font-weight: 800; }\n  .legend { display:flex; gap: 14px; margin-top: 8px; font-size: 11px; font-weight: 700; color: #8e97ac; }\n  .lg { display:inline-block; width: 14px; height: 3px; border-radius: 2px; margin-right: 5px; vertical-align: middle; }\n  .lg.s { background: #ffd27a; } .lg.m { background: #cfd6e6; } .lg.g { background: #ffae5c; } .lg.b { background: #6c8cff; }\n  @media (max-width: 520px) { .grid { grid-template-columns: repeat(2, 1fr); } }"
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "custom:button-card",
                  "template": "sky_base",
                  "custom_fields": {
                    "c": "[[[ \n  \n  const A = window.__astroLib || (window.__astroLib = new Function(variables.astro_lib)());\n  const TZ = hass.config.time_zone || 'Europe/Istanbul';\n  const fmtT = (t) => t ? new Date(t).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: TZ }) : '—';\n  const fmtD = (t) => new Date(t).toLocaleDateString('en-US', { day: 'numeric', month: 'short', timeZone: TZ });\n  const fmtDW = (t) => new Date(t).toLocaleDateString('en-US', { weekday: 'short', day: 'numeric', month: 'short', timeZone: TZ });\n  const inDays = (t) => { const d = Math.round((t - Date.now()) / 86400000); return d <= 0 ? 'today' : (d === 1 ? 'tomorrow' : 'in ' + d + ' days'); };\n  const LA = hass.config.latitude, LO = hass.config.longitude;\n\n  const now = Date.now(), p = A.phase(now), m = A.moonEcl(now), sg = A.sign(m.lon);\n  const nf = A.nextPhase(now, 180), nn = A.nextPhase(now, 0);\n  const fs = A.sign(A.moonEcl(nf).lon), ns = A.sign(A.moonEcl(nn).lon);\n  // moonrise / moonset today (sample)\n  const d0 = new Date(now); d0.setHours(0, 0, 0, 0); let rise = null, set = null, prev = A.moonHor(d0.getTime(), LA, LO).alt;\n  for (let k = 10; k <= 1440; k += 10) { const t = d0.getTime() + k * 60e3, a = A.moonHor(t, LA, LO).alt; if (prev < 0.125 && a >= 0.125 && !rise) rise = t; if (prev >= 0.125 && a < 0.125 && !set) set = t; prev = a; }\n  // realistic moon: lit limb path + soft terminator + craters\n  const r = 70, k = Math.cos(p.elong * Math.PI / 180), wax = p.waxing, rx = Math.abs(k) * r;\n  const lit = 'M 0 ' + (-r) + ' A ' + r + ' ' + r + ' 0 0 ' + (wax ? 1 : 0) + ' 0 ' + r + ' A ' + rx.toFixed(2) + ' ' + r + ' 0 0 ' + ((k < 0) === wax ? 1 : 0) + ' 0 ' + (-r);\n  const craters = [[-22, -28, 13], [18, -12, 9], [-8, 20, 16], [30, 30, 8], [-38, 8, 7], [8, -42, 6], [40, -5, 5], [-20, 44, 6]]\n    .map(c => '<circle cx=\"' + c[0] + '\" cy=\"' + c[1] + '\" r=\"' + c[2] + '\" fill=\"rgba(120,112,95,.22)\"/>').join('');\n  const svg = '<svg viewBox=\"-90 -90 180 180\" class=\"mn\"><defs>'\n    + '<radialGradient id=\"mg\" cx=\"-.25\" cy=\"-.3\" r=\"1.1\"><stop offset=\"0\" stop-color=\"#fbf7e6\"/><stop offset=\".7\" stop-color=\"#d9d2b8\"/><stop offset=\"1\" stop-color=\"#b8b096\"/></radialGradient>'\n    + '<clipPath id=\"mlit\"><path d=\"' + lit + '\"/></clipPath><filter id=\"mb\"><feGaussianBlur stdDeviation=\"1.6\"/></filter></defs>'\n    + '<circle r=\"' + (r + 16) + '\" fill=\"rgba(243,239,217,' + (0.05 + p.illum * 0.12).toFixed(3) + ')\" class=\"halo\"/>'\n    + '<circle r=\"' + r + '\" fill=\"#2a2d33\"/><circle r=\"' + r + '\" fill=\"rgba(255,255,255,.05)\"/>'\n    + '<g clip-path=\"url(#mlit)\" filter=\"url(#mb)\"><circle r=\"' + r + '\" fill=\"url(#mg)\"/>' + craters + '</g></svg>';\n  const row = (k, v, x) => '<div class=\"row\"><span class=\"k\">' + k + '</span><span class=\"v\">' + v + (x ? ' <span class=\"x\">' + x + '</span>' : '') + '</span></div>';\n  const pis = (s) => s.name === 'Pisces' ? ' <span class=\"pis\">♓︎ your sign</span>' : '';\n  return '<div class=\"ttl\">Moon</div>' + svg\n    + '<div class=\"pn\">' + A.phaseName(p.elong) + '</div><div class=\"pi\">' + Math.round(p.illum * 100) + '% lit · day ' + p.age.toFixed(1) + '</div>'\n    + '<div class=\"rows\">' + row('Moon in', sg.sym + ' ' + sg.name + pis(sg)) + row('Rise / set', fmtT(rise) + ' / ' + fmtT(set))\n    + row('Full moon', fmtDW(nf) + ' ' + fmtT(nf), fs.sym + ' ' + inDays(nf)) + row('New moon', fmtDW(nn) + ' ' + fmtT(nn), ns.sym + ' ' + inDays(nn)) + '</div>';\n ]]]"
                  },
                  "extra_styles": "\n    .ttl { font-size: 22px; font-weight: 800; color: #f1f4fb; letter-spacing: .2px; }\n    .sub { font-size: 12.5px; font-weight: 700; color: #9aa3b8; margin-top: 2px; }\n    .top { display:flex; justify-content: space-between; align-items: flex-end; gap: 10px; flex-wrap: wrap; margin-bottom: 6px; }\n    .rows { display:flex; flex-direction:column; gap: 7px; margin-top: 10px; }\n    .row { display:flex; justify-content: space-between; align-items: baseline; gap: 10px; font-size: 13.5px; }\n    .row .k { color: #8e97ac; font-weight: 700; font-size: 11px; letter-spacing: 1.1px; text-transform: uppercase; white-space: nowrap; }\n    .row .v { font-weight: 800; text-align: right; } .row .x { display: block; color: #9aa3b8; font-weight: 700; font-size: 11.5px; }\n    .chip { display:inline-block; padding: 2px 8px; border-radius: 99px; font-size: 11px; font-weight: 800; letter-spacing: .6px; }\n    .chip.ok { background: rgba(142,224,92,.16); color: #a6ea7c; } .chip.bad { background: rgba(224,119,111,.18); color: #ffab9f; animation: pulse 2.4s ease-in-out infinite; }\n    @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: .55; } }\n    @keyframes twk { 0%,100% { opacity: 1; } 50% { opacity: .45; } }\n    @keyframes breathe { 0%,100% { transform: scale(1); opacity: .9; } 50% { transform: scale(1.15); opacity: 1; } }\n    @media (prefers-reduced-motion: reduce) { * { animation: none !important; } }\n  .mn { width: 64%; max-width: 220px; display:block; margin: 6px auto 4px; overflow: visible; }\n  .mn .halo { transform-box: fill-box; transform-origin: center; animation: breathe 7s ease-in-out infinite; }\n  .pn { text-align:center; font-size: 19px; font-weight: 800; } .pi { text-align:center; font-size: 12.5px; color: #9aa3b8; font-weight: 700; }\n  .pis { font-size: 10.5px; color: #9fd3ff; font-weight: 800; background: rgba(111,208,242,.14); padding: 2px 7px; border-radius: 99px; margin-left: 4px; }"
                }
              ]
            },
            {
              "type": "grid",
              "column_span": 2,
              "cards": [
                {
                  "type": "custom:button-card",
                  "template": "sky_base",
                  "custom_fields": {
                    "c": "[[[ \n  \n  const A = window.__astroLib || (window.__astroLib = new Function(variables.astro_lib)());\n  const TZ = hass.config.time_zone || 'Europe/Istanbul';\n  const fmtT = (t) => t ? new Date(t).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: TZ }) : '—';\n  const fmtD = (t) => new Date(t).toLocaleDateString('en-US', { day: 'numeric', month: 'short', timeZone: TZ });\n  const fmtDW = (t) => new Date(t).toLocaleDateString('en-US', { weekday: 'short', day: 'numeric', month: 'short', timeZone: TZ });\n  const inDays = (t) => { const d = Math.round((t - Date.now()) / 86400000); return d <= 0 ? 'today' : (d === 1 ? 'tomorrow' : 'in ' + d + ' days'); };\n  const LA = hass.config.latitude, LO = hass.config.longitude;\n\n  const now = Date.now(), SD = variables.sky, R = 200, C0 = 210;\n  const sunA = A.sunHor(now, LA, LO).alt, day = sunA > -6;\n  const proj = (alt, az) => { if (alt < 0) return null; const rr = (90 - alt) / 90 * R, q = az * Math.PI / 180; return [C0 - rr * Math.sin(q), C0 - rr * Math.cos(q)]; };\n  const eq = (ra, dec) => A.eqToHor(ra, dec, now, LA, LO);\n  let g = '';\n  // grid: alt circles + cardinal points\n  for (const a of [30, 60]) g += '<circle cx=\"' + C0 + '\" cy=\"' + C0 + '\" r=\"' + ((90 - a) / 90 * R).toFixed(1) + '\" class=\"grid\"/>';\n  // constellation lines\n  for (const L of SD.lines) { let dpath = '', pen = false;\n    for (let i = 0; i < L.length; i += 2) { const h = eq(L[i], L[i + 1]), p = proj(h.alt, h.az);\n      if (p) { dpath += (pen ? 'L' : 'M') + p[0].toFixed(1) + ' ' + p[1].toFixed(1); pen = true; } else pen = false; }\n    if (dpath) g += '<path d=\"' + dpath + '\" class=\"cl\"/>'; }\n  // stars\n  const col = (bv) => bv < 0 ? '#aac8ff' : (bv < 0.5 ? '#e8efff' : (bv < 1.0 ? '#fff3dc' : '#ffd2a1'));\n  let tw = 0;\n  for (const s of SD.stars) { const h = eq(s[0], s[1]), p = proj(h.alt, h.az); if (!p) continue;\n    const rad = Math.max(0.5, 3.4 - s[2] * 0.72).toFixed(2), bright = s[2] < 1.6;\n    g += '<circle cx=\"' + p[0].toFixed(1) + '\" cy=\"' + p[1].toFixed(1) + '\" r=\"' + rad + '\" fill=\"' + col(s[3]) + '\"' + (bright ? ' class=\"tw\" style=\"animation-delay:-' + ((tw++ * 0.7) % 4).toFixed(1) + 's\"' : '') + '/>'; }\n  // constellation + star names\n  for (const l of SD.labels) { const h = eq(l[0], l[1]), p = proj(h.alt, h.az); if (p && h.alt > 8) g += '<text x=\"' + p[0].toFixed(1) + '\" y=\"' + p[1].toFixed(1) + '\" class=\"cn\">' + l[2].toUpperCase() + '</text>'; }\n  for (const n of SD.named) { const h = eq(n[0], n[1]), p = proj(h.alt, h.az); if (p && h.alt > 5) g += '<text x=\"' + (p[0] + 5).toFixed(1) + '\" y=\"' + (p[1] - 4).toFixed(1) + '\" class=\"sn\">' + n[2] + '</text>'; }\n  // ecliptic\n  let ecl = '', pen = false; for (let lon = 0; lon <= 360; lon += 3) { const q = A.eclToEq(lon, 0, now), h = eq(q.ra, q.dec), p = proj(h.alt, h.az);\n    if (p) { ecl += (pen ? 'L' : 'M') + p[0].toFixed(1) + ' ' + p[1].toFixed(1); pen = true; } else pen = false; }\n  g += '<path d=\"' + ecl + '\" class=\"ec\"/>';\n  // planets, moon, sun\n  const PC = { Mercury: '#c9c3b6', Venus: '#fff1c1', Mars: '#ff8a65', Jupiter: '#f3d9a4', Saturn: '#e8d08a' };\n  for (const n of Object.keys(PC)) { const h = A.planetHor(n, now, LA, LO), p = proj(h.alt, h.az); if (!p) continue;\n    g += '<circle cx=\"' + p[0].toFixed(1) + '\" cy=\"' + p[1].toFixed(1) + '\" r=\"4.2\" fill=\"' + PC[n] + '\" class=\"pl\"/><text x=\"' + (p[0] + 7).toFixed(1) + '\" y=\"' + (p[1] + 3.5).toFixed(1) + '\" class=\"pn\">' + n + '</text>'; }\n  const mh = A.moonHor(now, LA, LO), mp = proj(mh.alt, mh.az);\n  if (mp) { const ph = A.phase(now), r = 9, k = Math.cos(ph.elong * Math.PI / 180), rx = Math.abs(k) * r, w = ph.waxing;\n    g += '<g transform=\"translate(' + mp[0].toFixed(1) + ' ' + mp[1].toFixed(1) + ')\"><circle r=\"' + (r + 6) + '\" fill=\"rgba(243,239,217,.12)\"/><circle r=\"' + r + '\" fill=\"#3a3d44\"/>'\n      + '<path d=\"M 0 ' + (-r) + ' A ' + r + ' ' + r + ' 0 0 ' + (w ? 1 : 0) + ' 0 ' + r + ' A ' + rx.toFixed(2) + ' ' + r + ' 0 0 ' + ((k < 0) === w ? 1 : 0) + ' 0 ' + (-r) + '\" fill=\"#f3efd9\"/></g>'\n      + '<text x=\"' + (mp[0] + 13).toFixed(1) + '\" y=\"' + (mp[1] + 4).toFixed(1) + '\" class=\"pn\">Moon</text>'; }\n  const sp = proj(sunA, A.sunHor(now, LA, LO).az); const sunSvg = sp ? '<circle cx=\"' + sp[0].toFixed(1) + '\" cy=\"' + sp[1].toFixed(1) + '\" r=\"11\" fill=\"#ffd27a\" class=\"sunc\"/>' : '';\n  const card = ['N', 'E', 'S', 'W'].map((c, i) => { const q = [0, 90, 180, 270][i] * Math.PI / 180, rr = R + 11; return '<text x=\"' + (C0 - rr * Math.sin(q)).toFixed(1) + '\" y=\"' + (C0 - rr * Math.cos(q) + 4).toFixed(1) + '\" class=\"cd\">' + c + '</text>'; }).join('');\n  return '<div class=\"top\"><div class=\"ttl\">Sky over ' + (hass.config.location_name || 'home') + '</div><div class=\"sub\">' + (day ? 'Daylight — stars shown faded' : 'Live · looking up, north at top') + '</div></div>'\n    + '<svg viewBox=\"-16 -16 452 452\" class=\"chart ' + (day ? 'day' : '') + '\"><defs><radialGradient id=\"skyg\"><stop offset=\"0\" stop-color=\"' + (day ? '#3a6fb8' : '#0e1633') + '\"/><stop offset=\"1\" stop-color=\"' + (day ? '#1f3f73' : '#050814') + '\"/></radialGradient>'\n    + '<clipPath id=\"hc\"><circle cx=\"' + C0 + '\" cy=\"' + C0 + '\" r=\"' + R + '\"/></clipPath></defs>'\n    + '<circle cx=\"' + C0 + '\" cy=\"' + C0 + '\" r=\"' + R + '\" fill=\"url(#skyg)\"/><g clip-path=\"url(#hc)\" class=\"' + (day ? 'faded' : '') + '\">' + g + '</g><g clip-path=\"url(#hc)\">' + sunSvg + '</g>'\n    + '<circle cx=\"' + C0 + '\" cy=\"' + C0 + '\" r=\"' + R + '\" class=\"rim\"/>' + card + '</svg>';\n ]]]"
                  },
                  "grid_options": {
                    "columns": "full"
                  },
                  "extra_styles": "\n    .ttl { font-size: 22px; font-weight: 800; color: #f1f4fb; letter-spacing: .2px; }\n    .sub { font-size: 12.5px; font-weight: 700; color: #9aa3b8; margin-top: 2px; }\n    .top { display:flex; justify-content: space-between; align-items: flex-end; gap: 10px; flex-wrap: wrap; margin-bottom: 6px; }\n    .rows { display:flex; flex-direction:column; gap: 7px; margin-top: 10px; }\n    .row { display:flex; justify-content: space-between; align-items: baseline; gap: 10px; font-size: 13.5px; }\n    .row .k { color: #8e97ac; font-weight: 700; font-size: 11px; letter-spacing: 1.1px; text-transform: uppercase; white-space: nowrap; }\n    .row .v { font-weight: 800; text-align: right; } .row .x { display: block; color: #9aa3b8; font-weight: 700; font-size: 11.5px; }\n    .chip { display:inline-block; padding: 2px 8px; border-radius: 99px; font-size: 11px; font-weight: 800; letter-spacing: .6px; }\n    .chip.ok { background: rgba(142,224,92,.16); color: #a6ea7c; } .chip.bad { background: rgba(224,119,111,.18); color: #ffab9f; animation: pulse 2.4s ease-in-out infinite; }\n    @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: .55; } }\n    @keyframes twk { 0%,100% { opacity: 1; } 50% { opacity: .45; } }\n    @keyframes breathe { 0%,100% { transform: scale(1); opacity: .9; } 50% { transform: scale(1.15); opacity: 1; } }\n    @media (prefers-reduced-motion: reduce) { * { animation: none !important; } }\n  .chart { width: 100%; max-width: 560px; display:block; margin: 6px auto 0; }\n  .chart .grid { fill: none; stroke: rgba(255,255,255,.07); stroke-width: 1; }\n  .chart .cl { fill: none; stroke: rgba(150,180,255,.32); stroke-width: .9; }\n  .chart .ec { fill: none; stroke: rgba(255,210,120,.28); stroke-width: 1; stroke-dasharray: 2 4; }\n  .chart .tw { animation: twk 4s ease-in-out infinite; }\n  .chart .cn { fill: rgba(170,190,235,.45); font-size: 7.5px; font-weight: 800; letter-spacing: 1.2px; text-anchor: middle; font-family: 'Nunito', 'Roboto', sans-serif; }\n  .chart .sn { fill: rgba(235,240,255,.75); font-size: 8px; font-weight: 700; font-family: 'Nunito', 'Roboto', sans-serif; }\n  .chart .pn { fill: #ffe7b0; font-size: 9px; font-weight: 800; font-family: 'Nunito', 'Roboto', sans-serif; }\n  .chart .pl { filter: drop-shadow(0 0 4px rgba(255,230,170,.8)); }\n  .chart .sunc { filter: drop-shadow(0 0 14px rgba(255,210,120,.9)); }\n  .chart .rim { fill: none; stroke: rgba(255,255,255,.25); stroke-width: 1.2; }\n  .chart .cd { fill: #9aa3b8; font-size: 11px; font-weight: 800; text-anchor: middle; font-family: 'Nunito', 'Roboto', sans-serif; }\n  .chart .faded { opacity: .35; }"
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "vertical-stack",
                  "cards": [
                    {
                      "type": "custom:button-card",
                      "template": "sky_base",
                      "custom_fields": {
                        "c": "[[[ \n  \n  const A = window.__astroLib || (window.__astroLib = new Function(variables.astro_lib)());\n  const TZ = hass.config.time_zone || 'Europe/Istanbul';\n  const fmtT = (t) => t ? new Date(t).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: TZ }) : '—';\n  const fmtD = (t) => new Date(t).toLocaleDateString('en-US', { day: 'numeric', month: 'short', timeZone: TZ });\n  const fmtDW = (t) => new Date(t).toLocaleDateString('en-US', { weekday: 'short', day: 'numeric', month: 'short', timeZone: TZ });\n  const inDays = (t) => { const d = Math.round((t - Date.now()) / 86400000); return d <= 0 ? 'today' : (d === 1 ? 'tomorrow' : 'in ' + d + ' days'); };\n  const LA = hass.config.latitude, LO = hass.config.longitude;\n\n  const now = Date.now(), sun = A.sign(A.sunLon(now)), mo = A.sign(A.moonEcl(now).lon);\n  const day = (s) => Date.parse(s + 'T00:00:00');\n  const rx = A.MERC_RX.map(r => [day(r[0]), day(r[1]) + 86399000]);\n  const cur = rx.find(r => now >= r[0] && now <= r[1]), nxt = rx.find(r => r[0] > now);\n  const ecl = A.ECLIPSES.map(e => [day(e[0]), e[1]]).find(e => e[0] + 86400000 > now);\n  // next Pisces season: sun longitude crossing 330°\n  const cross = (f, target, start, stepH, maxDays) => { let a = start, fa = A.norm(f(a) - target + 180) - 180;\n    for (let t = start + stepH * 3600e3; t < start + maxDays * 86400000; t += stepH * 3600e3) { const fb = A.norm(f(t) - target + 180) - 180;\n      if (fa < 0 && fb >= 0 && fb - fa < 90) { let lo = a, hi = t; for (let i = 0; i < 25; i++) { const m = (lo + hi) / 2; if (A.norm(f(m) - target + 180) - 180 < 0) lo = m; else hi = m; } return hi; } a = t; fa = fb; } return null; };\n  const inPis = sun.name === 'Pisces';\n  const pStart = inPis ? null : cross(A.sunLon, 330, now, 12, 366), pEnd = cross(A.sunLon, 0, pStart || now, 12, 60);\n  // next full moon in Pisces, next time the Moon enters Pisces\n  let fp = null, t = now; for (let i = 0; i < 14 && !fp; i++) { const f = A.nextPhase(t, 180); if (A.sign(A.moonEcl(f).lon).name === 'Pisces') fp = f; t = f + 86400000; }\n  const mIn = mo.name === 'Pisces' ? null : cross((x) => A.moonEcl(x).lon, 330, now, 2, 30);\n  const chip = (cls, txt) => '<span class=\"chip ' + cls + '\">' + txt + '</span>';\n  const row = (k, v, x) => '<div class=\"row\"><span class=\"k\">' + k + '</span><span class=\"v\">' + v + (x ? '<span class=\"x\">' + x + '</span>' : '') + '</span></div>';\n  const merc = cur ? chip('bad', 'Retrograde') + ' until ' + fmtD(cur[1])\n    : chip('ok', 'Direct') + (nxt ? ' · next Rx ' + fmtD(nxt[0]) + '–' + fmtD(nxt[1]) : '');\n  const planets = ['Mercury', 'Venus', 'Mars', 'Jupiter', 'Saturn'].map(n => { const e = A.planetHor(n, now, LA, LO), s = A.sign(e.lon);\n    return '<div class=\"pl ' + (e.alt > 0 ? 'up' : '') + '\"><span class=\"pn\">' + n + '</span><span class=\"ps\">' + s.sym + ' ' + s.name + '</span><span class=\"pa\">' + (e.alt > 0 ? '↑ ' + e.alt.toFixed(0) + '°' : 'below') + '</span></div>'; }).join('');\n  return '<div class=\"ttl\">Astrology</div>'\n    + '<div class=\"signs\"><div class=\"sg\"><div class=\"sy\">' + sun.sym + '</div><div class=\"sn\">Sun in ' + sun.name + '</div><div class=\"sd\">' + sun.deg.toFixed(0) + '°</div></div>'\n    + '<div class=\"sg\"><div class=\"sy\">' + mo.sym + '</div><div class=\"sn\">Moon in ' + mo.name + '</div><div class=\"sd\">' + mo.deg.toFixed(0) + '°</div></div></div>'\n    + '<div class=\"rows\">' + row('Mercury', merc)\n    + row('Next eclipse', ecl ? ecl[1] + ' · ' + fmtD(ecl[0]) : '—', ecl ? inDays(ecl[0]) : '')\n    + '</div><div class=\"me\"><div class=\"mh\">♓︎ Pisces</div>'\n    + row('Pisces season', inPis ? chip('ok', 'Now') + ' until ' + fmtD(pEnd) : fmtD(pStart) + ' – ' + fmtD(pEnd), inPis ? '' : inDays(pStart))\n    + row('Full Moon in ♓︎', fp ? fmtDW(fp) : '—', fp ? inDays(fp) : '')\n    + row('Moon in ♓︎', mo.name === 'Pisces' ? chip('ok', 'Now') : fmtDW(mIn) + ' ' + fmtT(mIn), mo.name === 'Pisces' ? '' : inDays(mIn))\n    + '</div><div class=\"pls\">' + planets + '</div>';\n ]]]"
                      },
                      "extra_styles": "\n    .ttl { font-size: 22px; font-weight: 800; color: #f1f4fb; letter-spacing: .2px; }\n    .sub { font-size: 12.5px; font-weight: 700; color: #9aa3b8; margin-top: 2px; }\n    .top { display:flex; justify-content: space-between; align-items: flex-end; gap: 10px; flex-wrap: wrap; margin-bottom: 6px; }\n    .rows { display:flex; flex-direction:column; gap: 7px; margin-top: 10px; }\n    .row { display:flex; justify-content: space-between; align-items: baseline; gap: 10px; font-size: 13.5px; }\n    .row .k { color: #8e97ac; font-weight: 700; font-size: 11px; letter-spacing: 1.1px; text-transform: uppercase; white-space: nowrap; }\n    .row .v { font-weight: 800; text-align: right; } .row .x { display: block; color: #9aa3b8; font-weight: 700; font-size: 11.5px; }\n    .chip { display:inline-block; padding: 2px 8px; border-radius: 99px; font-size: 11px; font-weight: 800; letter-spacing: .6px; }\n    .chip.ok { background: rgba(142,224,92,.16); color: #a6ea7c; } .chip.bad { background: rgba(224,119,111,.18); color: #ffab9f; animation: pulse 2.4s ease-in-out infinite; }\n    @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: .55; } }\n    @keyframes twk { 0%,100% { opacity: 1; } 50% { opacity: .45; } }\n    @keyframes breathe { 0%,100% { transform: scale(1); opacity: .9; } 50% { transform: scale(1.15); opacity: 1; } }\n    @media (prefers-reduced-motion: reduce) { * { animation: none !important; } }\n  .signs { display:grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px; }\n  .sg { background: rgba(255,255,255,.04); border-radius: 16px; padding: 10px; text-align:center; }\n  .sy { font-size: 34px; line-height: 1; color: #f4e7b6; text-shadow: 0 0 14px rgba(244,231,182,.45); animation: twk 5s ease-in-out infinite; }\n  .sn { font-size: 13px; font-weight: 800; margin-top: 4px; } .sd { font-size: 11px; color: #8e97ac; font-weight: 700; }\n  .me { margin-top: 12px; padding: 10px 12px; border-radius: 16px; background: linear-gradient(135deg, rgba(111,208,242,.10), rgba(160,120,255,.10)); display:flex; flex-direction:column; gap: 7px; }\n  .mh { font-size: 13px; font-weight: 800; color: #bfe6ff; letter-spacing: .5px; }\n  .pls { display:grid; grid-template-columns: 1fr; gap: 4px; margin-top: 12px; }\n  .pl { display:grid; grid-template-columns: 1fr 1.3fr .8fr; font-size: 12.5px; color: #8e97ac; font-weight: 700; padding: 3px 0; border-top: 1px solid rgba(255,255,255,.05); }\n  .pl.up { color: #e9ecf3; } .pl .pn { font-weight: 800; } .pl .pa { text-align: right; }"
                    },
                    {
                      "type": "custom:button-card",
                      "name": "Susan Miller · Pisces",
                      "icon": "mdi:open-in-new",
                      "show_icon": true,
                      "show_name": true,
                      "show_state": false,
                      "tap_action": {
                        "action": "url",
                        "url_path": "[[[ const d = new Date(); return 'https://www.astrologyzone.com/forecasts/pisces-horoscope-for-' + d.toLocaleDateString('en-US', { month: 'long' }).toLowerCase() + '-' + d.getFullYear() + '/'; ]]]"
                      },
                      "styles": {
                        "card": [
                          {
                            "background": "rgba(160,120,255,.14)"
                          },
                          {
                            "border": "none"
                          },
                          {
                            "border-radius": "16px"
                          },
                          {
                            "padding": "10px 12px"
                          },
                          {
                            "font-family": "'Nunito', 'Roboto', sans-serif"
                          },
                          {
                            "margin-top": "10px"
                          }
                        ],
                        "grid": [
                          {
                            "grid-template-areas": "\"n i\""
                          },
                          {
                            "grid-template-columns": "1fr min-content"
                          }
                        ],
                        "name": [
                          {
                            "color": "#d9ccff"
                          },
                          {
                            "font-weight": "800"
                          },
                          {
                            "font-size": "14px"
                          },
                          {
                            "justify-self": "start"
                          }
                        ],
                        "icon": [
                          {
                            "width": "18px"
                          },
                          {
                            "color": "#d9ccff"
                          }
                        ]
                      }
