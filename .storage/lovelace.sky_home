                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Home",
          "path": "home",
          "icon": "mdi:home-lightning-bolt",
          "type": "sections",
          "max_columns": 3,
          "background": "radial-gradient(ellipse at 80% -10%, #1c2a24 0%, #101412 55%, #0b0d0c 100%)",
          "sections": [
            {
              "type": "grid",
              "column_span": 2,
              "cards": [
                {
                  "type": "custom:button-card",
                  "template": "home_base",
                  "entity": "input_boolean.adaptif_isik",
                  "tap_action": {
                    "action": "perform-action",
                    "perform_action": "input_boolean.toggle",
                    "target": {
                      "entity_id": "input_boolean.adaptif_isik"
                    },
                    "haptic": "medium"
                  },
                  "hold_action": {
                    "action": "more-info",
                    "entity": "sensor.adaptif_kelvin"
                  },
                  "triggers_update": [
                    "input_boolean.adaptif_isik",
                    "sensor.adaptif_kelvin",
                    "sensor.adaptif_parlaklik",
                    "input_number.adaptif_son_kelvin",
                    "input_number.adaptif_son_parlaklik",
                    "light.beyaz_abajur_hue",
                    "light.bitki_hasir_hue",
                    "light.tv_dixon_hue",
                    "sun.sun"
                  ],
                  "custom_fields": {
                    "c": "[[[\n  const S = (e) => states[e] ? states[e].state : undefined;\n  const N = (e) => { const v = parseFloat(S(e)); return isNaN(v) ? null : v; };\n  const chip = (t, c) => '<span class=\"chip ' + (c || '') + '\">' + t + '</span>';\n  const k2c = (k) => { const t = k / 100; let r, g, b;\n    if (t <= 66) { r = 255; g = 99.47 * Math.log(t) - 161.12; } else { r = 329.7 * Math.pow(t - 60, -0.1332); g = 288.12 * Math.pow(t - 60, -0.0755); }\n    if (t >= 66) b = 255; else if (t <= 19) b = 0; else b = 138.52 * Math.log(t - 10) - 305.04;\n    const q = (v) => Math.max(0, Math.min(255, Math.round(v)));\n    return 'rgb(' + q(r) + ',' + q(g) + ',' + q(b) + ')'; };\n\n  const on    = S('input_boolean.adaptif_isik') === 'on';\n  const k     = N('sensor.adaptif_kelvin');\n  const b     = N('sensor.adaptif_parlaklik');\n  const sonK  = N('input_number.adaptif_son_kelvin');\n  const sonB  = N('input_number.adaptif_son_parlaklik');\n  const elev  = states['sun.sun'] ? states['sun.sun'].attributes.elevation : null;\n\n  const LIGHTS = [\n    ['light.beyaz_abajur_hue', 'Beyaz abajur'],\n    ['light.bitki_hasir_hue',  'Bitki / hasır'],\n    ['light.tv_dixon_hue',     'TV Dixon']\n  ];\n\n  // where we sit on the 2250 K … 5500 K track\n  const pos = k == null ? 0 : Math.max(0, Math.min(100, (k - 2250) / (5500 - 2250) * 100));\n\n  let head = '<div class=\"hd\"><ha-icon icon=\"mdi:theme-light-dark\"></ha-icon>'\n    + '<div class=\"hn\">Adaptive light</div>'\n    + chip(on ? 'Following sun' : 'Paused', on ? 'ok' : '') + '</div>';\n\n  let track = '<div class=\"alk\">'\n    + '<div class=\"altrack\"><div class=\"almark\" style=\"left:calc(8px + (100% - 16px) * ' + (pos / 100).toFixed(4) + ')\"></div></div>'\n    + '<div class=\"alrow\"><span>2250 K</span>'\n    + '<b>' + (k == null ? '—' : k + ' K') + ' · ' + (b == null ? '—' : b + '%') + '</b>'\n    + '<span>5500 K</span></div>'\n    + '<div class=\"alsun\">sun ' + (elev == null ? '—' : elev.toFixed(1) + '°')\n    + (elev != null && elev < -12 ? ' · night floor' : (elev != null && elev >= 20 ? ' · full day' : '')) + '</div>'\n    + '</div>';\n\n  let rows = '';\n  for (const [id, label] of LIGHTS) {\n    const s = states[id];\n    const lit = s && s.state === 'on';\n    const lk = lit ? (s.attributes.color_temp_kelvin || null) : null;\n    const lp = lit ? Math.round((s.attributes.brightness || 0) / 2.55) : null;\n    const ct = lit && s.attributes.color_mode === 'color_temp';\n    const aligned = lit && ct && sonK != null && sonB != null\n      && Math.abs(lk - sonK) <= 75 && Math.abs(lp - sonB) <= 5;\n\n    let tag, cls;\n    if (!lit)            { tag = 'off';      cls = ''; }\n    else if (!on)        { tag = 'paused';   cls = ''; }\n    else if (aligned)    { tag = 'adaptive'; cls = 'ok'; }\n    else                 { tag = 'manual';   cls = 'warn'; }\n\n    const swatch = lit ? (ct ? k2c(lk) : 'rgb(190,120,220)') : 'rgba(255,255,255,.10)';\n    const glow = lit ? '0 0 10px ' + swatch : 'none';\n\n    rows += '<div class=\"alr\">'\n      + '<i class=\"aldot\" style=\"background:' + swatch + ';box-shadow:' + glow + '\"></i>'\n      + '<div class=\"aln\">' + label + '</div>'\n      + '<div class=\"alv\">' + (lit ? (ct ? lk + ' K · ' + lp + '%' : 'colour · ' + lp + '%') : '—') + '</div>'\n      + chip(tag, cls) + '</div>';\n  }\n\n  return head + track + rows;\n]]]"
                  },
                  "extra_styles": "\n    .hd { display:flex; align-items:center; gap: 8px; margin-bottom: 10px; } .hd ha-icon { --mdc-icon-size: 20px; color: #8ee05c; }\n    .hn { font-size: 18px; font-weight: 800; flex: 1; }\n    .chip { display:inline-block; padding: 3px 9px; border-radius: 99px; font-size: 11px; font-weight: 800; letter-spacing: .5px; background: rgba(255,255,255,.07); color: #aeb6c6; }\n    .chip.on { background: rgba(111,208,242,.16); color: #9fe2ff; } .chip.ok { background: rgba(142,224,92,.15); color: #a6ea7c; }\n    .chip.bad { background: rgba(224,119,111,.18); color: #ffab9f; } .chip.warn { background: rgba(231,183,95,.16); color: #f1cf8d; }\n    .alk { margin: 2px 0 12px; }\n    .altrack { position: relative; height: 12px; border-radius: 7px; overflow: visible;\n      background: linear-gradient(90deg, #ff9442 0%, #ffb46b 22%, #ffd7ad 45%, #ffeede 65%, #e4efff 85%, #cfe4ff 100%);\n      box-shadow: inset 0 0 0 1px rgba(255,255,255,.12); }\n    .almark { position: absolute; top: 50%; width: 16px; height: 16px; margin-left: -8px; border-radius: 50%;\n      background: #fff; transform: translateY(-50%); box-shadow: 0 0 0 3px rgba(0,0,0,.45), 0 2px 8px rgba(0,0,0,.5);\n      transition: left 1.5s ease; }\n    .alrow { display:flex; justify-content: space-between; align-items: baseline; margin-top: 8px;\n      font-size: 10.5px; font-weight: 800; letter-spacing: .5px; color: #8e97ac; }\n    .alrow b { font-size: 14px; color: #fff; letter-spacing: 0; }\n    .alsun { text-align: center; font-size: 10px; font-weight: 800; letter-spacing: .8px;\n      color: #6f768a; text-transform: uppercase; margin-top: 3px; }\n    .alr { display:flex; align-items: center; gap: 9px; padding: 7px 0; border-top: 1px solid rgba(255,255,255,.055); }\n    .aldot { width: 13px; height: 13px; border-radius: 50%; flex: none; transition: background .8s ease, box-shadow .8s ease; }\n    .aln { font-size: 13px; font-weight: 800; color: #dfe4ee; flex: 1; min-width: 0;\n      overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n    .alv { font-size: 11px; font-weight: 800; color: #8e97ac; white-space: nowrap; }\n",
                  "grid_options": {
                    "columns": "full"
                  }
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "custom:button-card",
                  "template": "home_base",
                  "entity": "sensor.waze_anne_evi",
                  "tap_action": {
                    "action": "url",
                    "url_path": "https://www.google.com/maps/dir/?api=1&destination=41.063497,29.00789&travelmode=driving"
                  },
                  "hold_action": {
                    "action": "more-info",
                    "entity": "sensor.waze_anne_evi"
                  },
                  "triggers_update": [
                    "sensor.waze_anne_evi",
                    "person.emir"
                  ],
                  "custom_fields": {
                    "c": "[[[\n  const s   = states['sensor.waze_anne_evi'];\n  const p   = states['person.emir'];\n  const min = s ? parseFloat(s.state) : null;\n  const km  = s && s.attributes.distance != null ? s.attributes.distance : null;\n  const ok  = min != null && !isNaN(min);\n  const kmh = (ok && km) ? km / (min / 60) : null;\n\n  // Istanbul city driving: ~25 km/h+ is a clear run, under 15 is crawling\n  let cls = '', label = 'No data';\n  if (kmh != null) {\n    if (kmh >= 25)      { cls = 'ok';   label = 'Clear'; }\n    else if (kmh >= 15) { cls = 'warn'; label = 'Moderate'; }\n    else                { cls = 'bad';  label = 'Heavy'; }\n  }\n\n  const atMum = p && p.state === \"Nursel'in Evi\";\n  const eta = ok ? new Date(Date.now() + min * 60000)\n    .toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: hass.config.time_zone || 'Europe/Istanbul' }) : '—';\n\n  const ago = (t) => { const m = (Date.now() - new Date(t).getTime()) / 60000;\n    if (isNaN(m)) return '—'; if (m < 1) return 'just now';\n    if (m < 60) return Math.round(m) + ' min ago'; return Math.round(m / 60) + ' h ago'; };\n\n  const chip = (t, c) => '<span class=\"chip ' + (c || '') + '\">' + t + '</span>';\n\n  const head = '<div class=\"hd\"><ha-icon icon=\"mdi:home-heart\"></ha-icon>'\n    + '<div class=\"hn\">Nursel&#39;in Evi</div>'\n    + chip(atMum ? 'You are there' : label, atMum ? 'on' : cls) + '</div>';\n\n  if (atMum) {\n    return head + '<div class=\"anbig\"><span class=\"anv ok\">Arrived</span></div>'\n      + '<div class=\"ansub\">Gayrettepe · Vefabayırı Sk. 12</div>';\n  }\n\n  // traffic bar: full = free-flowing, shrinks as the trip slows down\n  const pct = kmh == null ? 0 : Math.max(6, Math.min(100, kmh / 35 * 100));\n\n  return head\n    + '<div class=\"anbig\"><span class=\"anv ' + cls + '\">' + (ok ? Math.round(min) : '—') + '</span>'\n    + '<span class=\"anu\">min</span>'\n    + '<span class=\"ankm\">' + (km != null ? km.toFixed(1) + ' km' : '') + '</span></div>'\n    + '<div class=\"antrack\"><div class=\"anfill ' + cls + '\" style=\"width:' + pct.toFixed(0) + '%\"></div></div>'\n    + '<div class=\"anrow\"><span>' + label + (kmh != null ? ' · ' + Math.round(kmh) + ' km/h' : '') + '</span>'\n    + '<span>arrive ~' + eta + '</span></div>'\n    + '<div class=\"anroute\">' + ((s && s.attributes.route) ? s.attributes.route.split(';')[0].trim() : 'no route') + '</div>'\n    + '<div class=\"anfoot\">Waze · updated ' + (s ? ago(s.last_changed) : '—') + ' · tap to navigate</div>';\n]]]"
                  },
                  "extra_styles": "\n    .hd { display:flex; align-items:center; gap: 8px; margin-bottom: 10px; } .hd ha-icon { --mdc-icon-size: 20px; color: #8ee05c; }\n    .hn { font-size: 18px; font-weight: 800; flex: 1; }\n    .chip { display:inline-block; padding: 3px 9px; border-radius: 99px; font-size: 11px; font-weight: 800; letter-spacing: .5px; background: rgba(255,255,255,.07); color: #aeb6c6; }\n    .chip.on { background: rgba(111,208,242,.16); color: #9fe2ff; } .chip.ok { background: rgba(142,224,92,.15); color: #a6ea7c; }\n    .chip.bad { background: rgba(224,119,111,.18); color: #ffab9f; } .chip.warn { background: rgba(231,183,95,.16); color: #f1cf8d; }\n    .anbig { display:flex; align-items: baseline; gap: 7px; margin: 2px 0 10px; }\n    .anv { font-size: 44px; font-weight: 800; line-height: 1; color: #ececec; }\n    .anv.ok { color: #a6ea7c; } .anv.warn { color: #f1cf8d; } .anv.bad { color: #ffab9f; }\n    .anu { font-size: 14px; font-weight: 800; color: #8e97ac; }\n    .ankm { margin-left: auto; font-size: 15px; font-weight: 800; color: #c9d0dc; }\n    .antrack { height: 8px; border-radius: 5px; background: rgba(255,255,255,.07); overflow: hidden; }\n    .anfill { height: 100%; border-radius: 5px; background: #8e97ac; transition: width 1.4s ease; }\n    .anfill.ok { background: linear-gradient(90deg, #6fd0f2, #8ee05c); }\n    .anfill.warn { background: linear-gradient(90deg, #e7b75f, #f1cf8d); }\n    .anfill.bad { background: linear-gradient(90deg, #e0776f, #ff9b8f); }\n    .anrow { display:flex; justify-content: space-between; margin-top: 7px; font-size: 11px; font-weight: 800; letter-spacing: .3px; color: #8e97ac; }\n    .anroute { margin-top: 7px; font-size: 12px; font-weight: 700; color: #c9d0dc;\n      overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n    .anfoot { margin-top: 5px; font-size: 9.5px; font-weight: 800; letter-spacing: .7px; color: #6f768a; text-transform: uppercase; }\n"
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "custom:button-card",
                  "template": "home_base",
                  "entity": "sensor.dishwasher",
                  "triggers_update": [
                    "sensor.dishwasher",
                    "sensor.dishwasher_program_phase",
                    "sensor.dishwasher_remaining_time",
                    "sensor.dishwasher_elapsed_time",
                    "binary_sensor.dishwasher_door",
                    "sensor.dishwasher_salt_level",
                    "sensor.dishwasher_rinse_aid_level",
                    "sensor.dishwasher_powerdisk_level"
                  ],
                  "custom_fields": {
                    "c": "[[[ \n  \n  const S = (e) => states[e] ? states[e].state : undefined;\n  const N = (e) => { const v = parseFloat(S(e)); return isNaN(v) ? null : v; };\n  const ago = (t) => { const m = (Date.now() - new Date(t).getTime()) / 60000; if (isNaN(m)) return '—'; if (m < 60) return Math.round(m) + ' min ago'; if (m < 1440) return Math.round(m / 60) + ' h ago'; return Math.round(m / 1440) + ' days ago'; };\n  const tank = (p, label, c, sub) => { const v = Math.max(0, Math.min(100, p == null ? 0 : p));\n    return '<div class=\"tk\"><div class=\"tank\"><div class=\"liq\" style=\"height:' + v + '%;--c:' + c + '\"></div><span class=\"tv\">' + (p == null ? 'N/A' : Math.round(p) + '%') + '</span></div><div class=\"tl\">' + label + '</div>' + (sub ? '<div class=\"ts\">' + sub + '</div>' : '') + '</div>'; };\n  const chip = (txt, cls) => '<span class=\"chip ' + (cls || '') + '\">' + txt + '</span>';\n  const head = (icon, name, status, cls) => '<div class=\"hd\"><ha-icon icon=\"' + icon + '\"></ha-icon><div class=\"hn\">' + name + '</div>' + chip(status, cls) + '</div>';\n  const lvl = (p) => p == null ? '#5d605d' : (p < 20 ? '#e0776f' : (p < 45 ? '#e7b75f' : '#6fd0f2'));\n\n  const status = S('sensor.dishwasher') || 'off', phase = S('sensor.dishwasher_program_phase') || '';\n  const rem = N('sensor.dishwasher_remaining_time'), el = N('sensor.dishwasher_elapsed_time');\n  const door = S('binary_sensor.dishwasher_door') === 'on';\n  const done = status === 'program_ended' || phase.includes('finish');\n  const drying = phase.includes('dry');\n  const running = !done && (status === 'in_use' || status === 'running' || (phase && !['not_running', 'finished', ''].includes(phase)));\n  const mode = done ? 'done' : (drying ? 'dry' : (running ? 'wash' : 'idle'));\n  const pct = (rem != null && el != null && rem + el > 0) ? el / (rem + el) : (done ? 1 : 0);\n  const C = 2 * Math.PI * 52;\n  let fx = '';\n  if (mode === 'wash') for (let i = 0; i < 12; i++) fx += '<i class=\"bub\" style=\"left:' + (12 + (i * 37) % 76) + '%;animation-delay:-' + (i * 0.43).toFixed(2) + 's;animation-duration:' + (2.2 + (i % 4) * 0.5) + 's;width:' + (5 + i % 3 * 3) + 'px;height:' + (5 + i % 3 * 3) + 'px\"></i>';\n  if (mode === 'dry') for (let i = 0; i < 5; i++) fx += '<i class=\"stm\" style=\"left:' + (20 + i * 15) + '%;animation-delay:-' + (i * 0.7) + 's\"></i>';\n  if (mode === 'done') for (let i = 0; i < 6; i++) fx += '<i class=\"spk\" style=\"left:' + (15 + (i * 29) % 70) + '%;top:' + (15 + (i * 41) % 65) + '%;animation-delay:-' + (i * 0.35) + 's\"></i>';\n  const label = { wash: 'Washing', dry: 'Drying', done: 'Done', idle: status === 'off' ? 'Off' : 'Ready' }[mode];\n  const ph = phase && phase !== 'not_running' ? phase.replace(/_/g, ' ') : (door ? 'door open' : 'idle');\n  return head('mdi:dishwasher', 'Dishwasher', label, mode === 'idle' ? '' : (mode === 'done' ? 'ok' : 'on'))\n    + '<div class=\"dw ' + mode + '\"><svg viewBox=\"0 0 120 120\" class=\"ring\"><circle cx=\"60\" cy=\"60\" r=\"52\" class=\"rt\"/>'\n    + '<circle cx=\"60\" cy=\"60\" r=\"52\" class=\"rp\" stroke-dasharray=\"' + (C * pct).toFixed(1) + ' ' + C.toFixed(1) + '\" transform=\"rotate(-90 60 60)\"/></svg>'\n    + '<div class=\"drum\"><div class=\"water\"></div>' + fx + '<ha-icon icon=\"' + (mode === 'done' ? 'mdi:check-bold' : 'mdi:silverware-fork-knife') + '\" class=\"di\"></ha-icon></div></div>'\n    + '<div class=\"meta\">' + (running || drying ? '<b>' + (rem != null ? rem + ' min' : '—') + '</b> left · ' + ph : ph) + '</div>'\n    + '<div class=\"tanks\">' + tank(N('sensor.dishwasher_salt_level'), 'Salt', '#cfe3ff') + tank(N('sensor.dishwasher_rinse_aid_level'), 'Rinse aid', '#7fd4ff') + tank(N('sensor.dishwasher_powerdisk_level'), 'PowerDisk', '#b7f08f') + '</div>';\n ]]]"
                  },
                  "extra_styles": "\n    .hd { display:flex; align-items:center; gap: 8px; margin-bottom: 10px; } .hd ha-icon { --mdc-icon-size: 20px; color: #8ee05c; }\n    .hn { font-size: 18px; font-weight: 800; flex: 1; }\n    .chip { display:inline-block; padding: 3px 9px; border-radius: 99px; font-size: 11px; font-weight: 800; letter-spacing: .5px; background: rgba(255,255,255,.07); color: #aeb6c6; }\n    .chip.on { background: rgba(111,208,242,.16); color: #9fe2ff; } .chip.ok { background: rgba(142,224,92,.15); color: #a6ea7c; }\n    .chip.bad { background: rgba(224,119,111,.18); color: #ffab9f; animation: pulse 2s ease-in-out infinite; } .chip.warn { background: rgba(231,183,95,.16); color: #f1cf8d; }\n    .meta { font-size: 12px; color: #8e97ac; font-weight: 700; margin-top: 8px; text-align: center; } .meta b { color: #fff; }\n    .tanks { display:flex; justify-content: center; gap: 14px; margin-top: 12px; } .tanks.wrap { flex-wrap: wrap; gap: 12px 14px; } .tanks.one { margin-top: 8px; }\n    .tk { display:flex; flex-direction: column; align-items: center; gap: 4px; }\n    .tank { position: relative; width: 46px; height: 62px; border-radius: 13px; overflow: hidden; background: rgba(255,255,255,.05); box-shadow: inset 0 0 0 1.5px rgba(255,255,255,.1); }\n    .liq { position:absolute; left:0; right:0; bottom:0; background: var(--c); opacity: .85; transition: height 1.2s ease; }\n    .liq::before { content:''; position:absolute; left:0; top:-6px; width: 200%; height: 7px;\n      background: radial-gradient(circle at 8px 7px, var(--c) 6px, transparent 6.5px) repeat-x; background-size: 16px 7px; animation: wave 2.4s linear infinite; }\n    @keyframes wave { from { transform: translateX(0); } to { transform: translateX(-50%); } }\n    .tv { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-size: 12px; font-weight: 800; color: #fff; text-shadow: 0 1px 4px rgba(0,0,0,.6); }\n    .tl { font-size: 11px; font-weight: 800; color: #c9d0dc; } .ts { font-size: 10px; color: #8ee05c; font-weight: 800; }\n    .ring { position:absolute; inset:0; width:100%; height:100%; } .ring .rt { fill:none; stroke: rgba(255,255,255,.07); stroke-width: 6; }\n    .ring .rp { fill:none; stroke: #6fd0f2; stroke-width: 6; stroke-linecap: round; transition: stroke-dasharray 1s; }\n    @keyframes spin { to { transform: rotate(360deg); } }\n    @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: .55; } }\n    @media (prefers-reduced-motion: reduce) { * { animation: none !important; } }\n    .dw { position: relative; width: 132px; height: 132px; margin: 4px auto 0; }\n    .drum { position:absolute; inset: 16px; border-radius: 50%; overflow: hidden; background: radial-gradient(circle at 40% 35%, #2a3238, #151a1d); box-shadow: inset 0 0 0 3px rgba(255,255,255,.08); }\n    .water { position:absolute; left:-20%; right:-20%; bottom: -60%; height: 60%; background: rgba(111,208,242,.35); border-radius: 40%; transition: bottom 1s; }\n    .dw.wash .water { bottom: -8%; animation: slosh 3s ease-in-out infinite; }\n    @keyframes slosh { 0%,100% { transform: rotate(-6deg); } 50% { transform: rotate(6deg); } }\n    .di { position:absolute; inset:0; margin:auto; --mdc-icon-size: 34px; color: rgba(255,255,255,.35); display:flex; align-items:center; justify-content:center; }\n    .dw.done .di { color: #8ee05c; } .dw.wash .di { color: rgba(255,255,255,.7); }\n    .bub { position:absolute; bottom: -10px; border-radius: 50%; border: 1.5px solid rgba(200,235,255,.8); background: rgba(255,255,255,.12); animation: rise 2.6s ease-in infinite; }\n    @keyframes rise { 0% { transform: translateY(0) scale(.6); opacity: 0; } 15% { opacity: 1; } 100% { transform: translateY(-110px) scale(1.1); opacity: 0; } }\n    .stm { position:absolute; bottom: 20%; width: 10px; height: 26px; border-radius: 50%; background: rgba(255,255,255,.28); filter: blur(4px); animation: steam 3s ease-out infinite; }\n    @keyframes steam { 0% { transform: translateY(0) scaleX(.6); opacity: 0; } 30% { opacity: .9; } 100% { transform: translateY(-60px) scaleX(1.4); opacity: 0; } }\n    .spk { position:absolute; width: 8px; height: 8px; background: #d5f5c5; clip-path: polygon(50% 0,62% 38%,100% 50%,62% 62%,50% 100%,38% 62%,0 50%,38% 38%); animation: twinkle 1.6s ease-in-out infinite; }\n    @keyframes twinkle { 0%,100% { transform: scale(.3); opacity: .2; } 50% { transform: scale(1.2); opacity: 1; } }"
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "custom:button-card",
                  "template": "home_base",
                  "entity": "fan.dyson_x6p_eu_thb1395a",
                  "triggers_update": [
