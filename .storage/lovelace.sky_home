                  ],
                  "custom_fields": {
                    "c": "[[[ \n  \n  const S = (e) => states[e] ? states[e].state : undefined;\n  const N = (e) => { const v = parseFloat(S(e)); return isNaN(v) ? null : v; };\n  const ago = (t) => { const m = (Date.now() - new Date(t).getTime()) / 60000; if (isNaN(m)) return '—'; if (m < 60) return Math.round(m) + ' min ago'; if (m < 1440) return Math.round(m / 60) + ' h ago'; return Math.round(m / 1440) + ' days ago'; };\n  const tank = (p, label, c, sub) => { const v = Math.max(0, Math.min(100, p == null ? 0 : p));\n    return '<div class=\"tk\"><div class=\"tank\"><div class=\"liq\" style=\"height:' + v + '%;--c:' + c + '\"></div><span class=\"tv\">' + (p == null ? 'N/A' : Math.round(p) + '%') + '</span></div><div class=\"tl\">' + label + '</div>' + (sub ? '<div class=\"ts\">' + sub + '</div>' : '') + '</div>'; };\n  const chip = (txt, cls) => '<span class=\"chip ' + (cls || '') + '\">' + txt + '</span>';\n  const head = (icon, name, status, cls) => '<div class=\"hd\"><ha-icon icon=\"' + icon + '\"></ha-icon><div class=\"hn\">' + name + '</div>' + chip(status, cls) + '</div>';\n  const lvl = (p) => p == null ? '#5d605d' : (p < 20 ? '#e0776f' : (p < 45 ? '#e7b75f' : '#6fd0f2'));\n\n  const v = S('vacuum.dyson_7vs_eu_unb6863a') || 'unknown', b = N('sensor.dyson_7vs_eu_unb6863a_battery');\n  const cleaning = v === 'cleaning', back = v === 'returning', err = v === 'error';\n  const chargingV = S('binary_sensor.corridor_dyson_7vs_eu_unb6863a_charging') === 'on';\n  const last = S('sensor.dyson_7vs_eu_unb6863a_last_clean');\n  return head('mdi:robot-vacuum', 'Vacuum', v.charAt(0).toUpperCase() + v.slice(1), cleaning ? 'on' : (err ? 'bad' : ''))\n    + '<div class=\"vc ' + (cleaning ? 'run' : (back ? 'back' : 'dock')) + '\"><div class=\"floor\"></div><div class=\"trail\"></div>'\n    + '<ha-icon icon=\"mdi:robot-vacuum\" class=\"bot\"></ha-icon><div class=\"dockb ' + (chargingV ? 'chg' : '') + '\"></div></div>'\n    + '<div class=\"tanks one\">' + tank(b, 'Battery', lvl(b), chargingV ? 'charging' : '') + '</div>'\n    + '<div class=\"meta\">Last clean ' + (last ? ago(last) : '—') + ' · ' + (S('select.dyson_7vs_eu_unb6863a_power_level') || '') + '</div>';\n ]]]"
                  },
                  "extra_styles": "\n    .hd { display:flex; align-items:center; gap: 8px; margin-bottom: 10px; } .hd ha-icon { --mdc-icon-size: 20px; color: #8ee05c; }\n    .hn { font-size: 18px; font-weight: 800; flex: 1; }\n    .chip { display:inline-block; padding: 3px 9px; border-radius: 99px; font-size: 11px; font-weight: 800; letter-spacing: .5px; background: rgba(255,255,255,.07); color: #aeb6c6; }\n    .chip.on { background: rgba(111,208,242,.16); color: #9fe2ff; } .chip.ok { background: rgba(142,224,92,.15); color: #a6ea7c; }\n    .chip.bad { background: rgba(224,119,111,.18); color: #ffab9f; animation: pulse 2s ease-in-out infinite; } .chip.warn { background: rgba(231,183,95,.16); color: #f1cf8d; }\n    .meta { font-size: 12px; color: #8e97ac; font-weight: 700; margin-top: 8px; text-align: center; } .meta b { color: #fff; }\n    .tanks { display:flex; justify-content: center; gap: 14px; margin-top: 12px; } .tanks.wrap { flex-wrap: wrap; gap: 12px 14px; } .tanks.one { margin-top: 8px; }\n    .tk { display:flex; flex-direction: column; align-items: center; gap: 4px; }\n    .tank { position: relative; width: 46px; height: 62px; border-radius: 13px; overflow: hidden; background: rgba(255,255,255,.05); box-shadow: inset 0 0 0 1.5px rgba(255,255,255,.1); }\n    .liq { position:absolute; left:0; right:0; bottom:0; background: var(--c); opacity: .85; transition: height 1.2s ease; }\n    .liq::before { content:''; position:absolute; left:0; top:-6px; width: 200%; height: 7px;\n      background: radial-gradient(circle at 8px 7px, var(--c) 6px, transparent 6.5px) repeat-x; background-size: 16px 7px; animation: wave 2.4s linear infinite; }\n    @keyframes wave { from { transform: translateX(0); } to { transform: translateX(-50%); } }\n    .tv { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-size: 12px; font-weight: 800; color: #fff; text-shadow: 0 1px 4px rgba(0,0,0,.6); }\n    .tl { font-size: 11px; font-weight: 800; color: #c9d0dc; } .ts { font-size: 10px; color: #8ee05c; font-weight: 800; }\n    .ring { position:absolute; inset:0; width:100%; height:100%; } .ring .rt { fill:none; stroke: rgba(255,255,255,.07); stroke-width: 6; }\n    .ring .rp { fill:none; stroke: #6fd0f2; stroke-width: 6; stroke-linecap: round; transition: stroke-dasharray 1s; }\n    @keyframes spin { to { transform: rotate(360deg); } }\n    @keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: .55; } }\n    @media (prefers-reduced-motion: reduce) { * { animation: none !important; } }\n    .vc { position: relative; height: 92px; border-radius: 16px; overflow: hidden; background: rgba(255,255,255,.03); margin-top: 2px; }\n    .floor { position:absolute; inset:0; background: repeating-linear-gradient(90deg, rgba(255,255,255,.03) 0 28px, transparent 28px 56px); }\n    .bot { position:absolute; --mdc-icon-size: 34px; color: #cfd6e6; left: 12px; top: 29px; display:flex; }\n    .run .bot { color: #9fe2ff; animation: roam 9s ease-in-out infinite; }\n    @keyframes roam { 0% { left: 12px; top: 10px; } 25% { left: 75%; top: 12px; } 50% { left: 70%; top: 50px; } 75% { left: 20%; top: 52px; } 100% { left: 12px; top: 10px; } }\n    .back .bot { animation: home 3s ease-in-out infinite; } @keyframes home { from { left: 70%; } to { left: 12px; } }\n    .dockb { position:absolute; left: 4px; top: 30px; width: 6px; height: 32px; border-radius: 3px; background: rgba(255,255,255,.2); }\n    .dockb.chg { background: #8ee05c; box-shadow: 0 0 10px #8ee05c; animation: pulse 1.6s ease-in-out infinite; }"
