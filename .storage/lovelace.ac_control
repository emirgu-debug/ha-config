                  },
                  "extra_styles": "\n    .wi { --mdc-icon-size: 34px; color: #fff; filter: drop-shadow(0 2px 6px rgba(0,0,0,.35)); }\n    .wt { line-height: 1.12; text-align: left; text-shadow: 0 1px 6px rgba(0,0,0,.45); }\n    .wc { font-size: 11px; font-weight: 800; letter-spacing: 1.1px; color: rgba(255,255,255,.78); text-transform: uppercase; }\n    .wv { font-size: 22px; font-weight: 800; color: #fff; } .wv sup { font-size: 10px; } .wh { font-size: 13px; color: rgba(255,255,255,.8); font-weight: 700; }\n    .hl { font-size: 11px; font-weight: 800; color: #d5f5c5; }\n    .chip { display:flex; align-items:center; gap:6px; padding: 6px 11px; border-radius: 99px; color: #fff;\n      background: rgba(10,14,20,.38); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }\n    .chip ha-icon { --mdc-icon-size: 16px; color: rgba(255,255,255,.55); } .chip.on ha-icon { color: #6fd0f2; } .chip.on { box-shadow: inset 0 0 0 1px rgba(111,208,242,.45); }\n    .cn { font-size: 13px; font-weight: 800; } .ct { font-size: 13px; font-weight: 700; color: rgba(255,255,255,.82); }\n    #sky i { position: absolute; display: block; }\n    .star { background: #fff; border-radius: 50%; animation: tw 3s ease-in-out infinite; box-shadow: 0 0 4px rgba(255,255,255,.8); }\n    @keyframes tw { 0%,100% { opacity: .25; } 50% { opacity: 1; } }\n    .moon { position: absolute; right: 22%; top: 10%; width: 34px; height: 34px; filter: drop-shadow(0 0 10px rgba(243,239,217,.55)); }\n    .sun { width: 90px; height: 90px; left: 18%; top: -38px; border-radius: 50%;\n      background: radial-gradient(circle, rgba(255,244,200,.95) 0%, rgba(255,214,120,.55) 35%, rgba(255,200,100,0) 70%); animation: glow 6s ease-in-out infinite; }\n    .sun.low { top: auto; bottom: -46px; background: radial-gradient(circle, rgba(255,210,150,.95) 0%, rgba(255,140,90,.55) 38%, rgba(255,120,80,0) 70%); }\n    @keyframes glow { 0%,100% { transform: scale(1); opacity: .9; } 50% { transform: scale(1.12); opacity: 1; } }\n    .cloud { left: -30%; width: 180px; height: 46px; border-radius: 50px; background: rgba(255,255,255,.5); filter: blur(10px);\n      transform: scale(var(--sc)); animation: drift 90s linear infinite; }\n    .cloud.dark { background: rgba(60,66,78,.7); }\n    @keyframes drift { from { left: -30%; } to { left: 110%; } }\n    .rain { top: -20px; width: 1.4px; height: 16px; background: linear-gradient(transparent, rgba(190,220,255,.85)); animation: fall .7s linear infinite; }\n    @keyframes fall { from { transform: translateY(-20px); } to { transform: translateY(140px); } }\n    .snow { top: -8px; border-radius: 50%; background: rgba(255,255,255,.9); animation: flake 6s linear infinite; }\n    @keyframes flake { 0% { transform: translate(0,-10px); } 50% { transform: translate(10px,60px); } 100% { transform: translate(-6px,140px); } }\n    .fog { left: -50%; width: 200%; height: 18px; background: linear-gradient(90deg, transparent, rgba(255,255,255,.35), transparent); filter: blur(6px); animation: fogm 30s ease-in-out infinite alternate; }\n    @keyframes fogm { from { transform: translateX(-10%); } to { transform: translateX(10%); } }\n    .gust { left: -20%; width: 90px; height: 1.5px; background: linear-gradient(90deg, transparent, rgba(255,255,255,.6), transparent); animation: gust 3s linear infinite; }\n    @keyframes gust { from { left: -20%; } to { left: 110%; } }\n    .flash { inset: 0; background: rgba(230,235,255,.9); opacity: 0; animation: flash 7s infinite; }\n    @keyframes flash { 0%,88%,92%,96%,100% { opacity: 0; } 90%,94% { opacity: .55; } }\n    @media (prefers-reduced-motion: reduce) { #sky i, #sky svg { animation: none !important; } }\n    @media (max-width: 560px) { #container { grid-template-areas: \"wx off\" \"rooms rooms\" !important; grid-template-columns: 1fr auto !important; row-gap: 10px; } }"
                }
              ]
