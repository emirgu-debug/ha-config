                              "name": [
                                {
                                  "font-size": "12.5px"
                                },
                                {
                                  "font-weight": "800"
                                },
                                {
                                  "color": "[[[ return (false) ? '#d5f5c5' : '#c9d0dc'; ]]]"
                                }
