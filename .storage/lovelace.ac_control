                    },
                    {
                      "type": "custom:button-card",
                      "entity": "fan.dyson_x6p_eu_thb1395a",
                      "show_icon": false,
                      "show_name": false,
                      "show_state": false,
                      "triggers_update": [
                        "fan.dyson_x6p_eu_thb1395a",
                        "humidifier.dyson_x6p_eu_thb1395a",
                        "select.dyson_x6p_eu_thb1395a_oscillation",
                        "switch.dyson_x6p_eu_thb1395a_night_mode",
                        "number.dyson_x6p_eu_thb1395a_sleep_timer",
                        "sensor.dyson_x6p_eu_thb1395a_air_quality_index",
                        "sensor.dyson_x6p_eu_thb1395a_air_quality_category",
                        "sensor.dyson_x6p_eu_thb1395a_pm2_5",
                        "sensor.dyson_x6p_eu_thb1395a_voc",
                        "sensor.dyson_x6p_eu_thb1395a_hepa_filter_life",
                        "sensor.dyson_x6p_eu_thb1395a_humidity",
                        "sun.sun",
                        "switch.ikinci_priz",
                        "sensor.ikinci_priz_power"
                      ],
                      "tap_action": {
                        "action": "none"
                      },
                      "custom_fields": {
                        "hdr": "[[[\n  const f = states['fan.dyson_x6p_eu_thb1395a'], h = states['humidifier.dyson_x6p_eu_thb1395a'], t = parseFloat(states['number.dyson_x6p_eu_thb1395a_sleep_timer'].state) || 0;\n  const on = f.state === 'on';\n  const seen = Math.max(...['sensor.dyson_x6p_eu_thb1395a_air_quality_index', 'sensor.dyson_x6p_eu_thb1395a_temperature', 'sensor.dyson_x6p_eu_thb1395a_humidity', 'fan.dyson_x6p_eu_thb1395a']\n    .map(e => states[e] ? Date.parse(states[e].last_updated) : 0));\n  const mins = (Date.now() - seen) / 60000;\n  const hhmm = (ts) => new Date(ts).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: hass.config.time_zone || 'Europe/Istanbul' });\n  const stale = mins > 30;\n  let chips = stale\n    ? '<span class=\"ch bad\">NO DATA · last seen ' + hhmm(seen) + '</span>'\n    : (on ? '<span class=\"ch on\">Running</span>' : '<span class=\"ch\">Standby</span>');\n  if (!stale) {\n    if (h.state === 'on') chips += '<span class=\"ch hu\">' + (on ? 'Humidify ' : 'Humidify ready ') + (h.attributes.humidity ?? '—') + '%</span>';\n    if (t > 0) chips += '<span class=\"ch tm\">Sleep ' + t + 'm</span>';\n  }\n  return '<div class=\"hl\">Dyson · purifier</div><div class=\"hr\">' + chips + '</div>';\n]]]",
                        "st": {
                          "card": {
                            "type": "custom:button-card",
                            "entity": "fan.dyson_x6p_eu_thb1395a",
                            "show_name": false,
                            "show_state": false,
                            "icon": "mdi:fan",
                            "tap_action": {
                              "action": "perform-action",
                              "perform_action": "fan.toggle",
                              "haptic": "light",
                              "target": {
                                "entity_id": "fan.dyson_x6p_eu_thb1395a"
                              }
                            },
                            "custom_fields": {
                              "lbl": "[[[\n  const f = states['fan.dyson_x6p_eu_thb1395a'], on = f.state === 'on', p = f.attributes.percentage || 0;\n  const mode = (f.attributes.preset_mode || 'manual').toUpperCase();\n  const hhmm = (ts) => new Date(ts).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: hass.config.time_zone || 'Europe/Istanbul' });\n  const since = hhmm(Date.parse(f.last_changed));\n  return '<div class=\"pv\">' + (on ? p + '<small>%</small>' : 'OFF') + '</div>'\n    + '<div class=\"pm\">' + (on ? mode + (f.attributes.night_mode ? ' · NIGHT' : '') + (f.attributes.oscillating ? ' · OSC' : '') : 'standby') + '</div>'\n    + '<div class=\"ps\">' + (on ? 'running' : 'off') + ' since ' + since + '</div>';\n]]]"
                            },
                            "styles": {
                              "card": [
                                {
                                  "background": "none"
                                },
                                {
                                  "box-shadow": "none"
                                },
                                {
                                  "border": "none"
                                },
                                {
                                  "padding": "2px 0"
                                },
                                {
                                  "font-family": "'Nunito', 'Roboto', sans-serif"
                                },
                                {
                                  "transition": "transform .12s ease"
                                }
                              ],
                              "grid": [
                                {
                                  "grid-template-areas": "\"i\" \"lbl\""
                                },
                                {
                                  "row-gap": "4px"
                                }
                              ],
                              "icon": [
                                {
                                  "width": "78px"
                                },
                                {
                                  "height": "78px"
                                },
                                {
                                  "color": "[[[ return states['fan.dyson_x6p_eu_thb1395a'].state === 'on' ? '#6fd0f2' : '#5d605d'; ]]]"
                                },
                                {
                                  "animation": "[[[ const f = states['fan.dyson_x6p_eu_thb1395a']; if (f.state !== 'on') return 'none'; const p = f.attributes.percentage || 10; return 'acspin ' + (2.6 - p / 100 * 2.1).toFixed(2) + 's linear infinite'; ]]]"
                                },
                                {
                                  "filter": "[[[ return states['fan.dyson_x6p_eu_thb1395a'].state === 'on' ? 'drop-shadow(0 0 14px rgba(111,208,242,.35))' : 'none'; ]]]"
                                }
                              ],
                              "custom_fields": {
                                "lbl": [
                                  {
                                    "line-height": "1.1"
                                  }
                                ]
                              }
                            },
                            "extra_styles": "@keyframes acspin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }\n    #card:active { transform: scale(.94); }\n    .pv { font-size: 24px; font-weight: 800; color: #ececec; } .pv small { font-size: 12px; }\n    .pm { font-size: 9.5px; font-weight: 800; letter-spacing: 1.1px; color: #8b8f8b; }\n  .ps { font-size: 10px; font-weight: 700; color: #8b8f8b; letter-spacing: .3px; margin-top: 1px; }"
                          }
                        },
                        "aq": {
                          "card": {
                            "type": "custom:button-card",
                            "entity": "sensor.dyson_x6p_eu_thb1395a_air_quality_index",
                            "show_name": false,
                            "show_icon": false,
                            "show_state": false,
                            "tap_action": {
                              "action": "more-info"
                            },
                            "custom_fields": {
                              "d": "[[[ const n = (e) => { const x = parseFloat(states[e]?.state); return isNaN(x) ? null : x; };\n      const aqi = n('sensor.dyson_x6p_eu_thb1395a_air_quality_index'), cat = states['sensor.dyson_x6p_eu_thb1395a_air_quality_category']?.state || '—';\n      const col = aqi == null ? '#5d605d' : (aqi <= 50 ? '#8ee05c' : (aqi <= 100 ? '#e7b75f' : '#e0776f'));\n      const R = 52, C0 = 2 * Math.PI * R, fill = Math.min(1, (aqi || 0) / 150);\n      return '<svg viewBox=\"0 0 130 130\" class=\"ring\"><circle cx=\"65\" cy=\"65\" r=\"' + R + '\" class=\"rt\"/>'\n        + '<circle cx=\"65\" cy=\"65\" r=\"' + R + '\" class=\"rp\" style=\"stroke:' + col + '\" stroke-dasharray=\"' + (C0 * fill).toFixed(1) + ' ' + C0.toFixed(1) + '\" transform=\"rotate(-90 65 65)\"/></svg>'\n        + '<div class=\"mid\"><div class=\"k\">AIR</div><div class=\"av\" style=\"color:' + col + '\">' + (aqi ?? '—') + '</div><div class=\"ac\">' + cat + '</div></div>'; ]]]",
                              "sub": "[[[ const n = (e) => { const x = parseFloat(states[e]?.state); return isNaN(x) ? null : x; };\n      const cell = (k, val) => '<div class=\"c\"><span>' + k + '</span><b>' + val + '</b></div>';\n      return cell('PM2.5', (n('sensor.dyson_x6p_eu_thb1395a_pm2_5') ?? '—') + ' μg') + cell('VOC', (n('sensor.dyson_x6p_eu_thb1395a_voc') ?? '—')) + cell('FILTER', (n('sensor.dyson_x6p_eu_thb1395a_hepa_filter_life') ?? '—') + '%'); ]]]"
                            },
                            "styles": {
                              "card": [
                                {
                                  "background": "#2d2e2d"
                                },
                                {
                                  "border": "none"
                                },
                                {
                                  "border-radius": "18px"
                                },
                                {
                                  "padding": "8px 8px 10px"
                                },
                                {
                                  "box-shadow": "0 8px 18px rgba(0,0,0,.35)"
                                },
                                {
                                  "font-family": "'Nunito', 'Roboto', sans-serif"
                                }
                              ],
                              "grid": [
                                {
                                  "grid-template-areas": "\"d\" \"sub\""
                                },
                                {
                                  "row-gap": "6px"
                                }
                              ],
                              "custom_fields": {
                                "d": [
                                  {
                                    "position": "relative"
                                  },
                                  {
                                    "width": "100%"
                                  },
                                  {
                                    "aspect-ratio": "1 / 1"
                                  }
                                ],
                                "sub": [
                                  {
                                    "display": "grid"
                                  },
                                  {
                                    "grid-template-columns": "repeat(3, 1fr)"
                                  },
                                  {
                                    "gap": "4px"
                                  }
                                ]
                              }
                            },
                            "extra_styles": ".ring { position:absolute; inset:0; width:100%; height:100%; }\n    .ring .rt { fill:none; stroke: rgba(255,255,255,.07); stroke-width: 7; }\n    .ring .rp { fill:none; stroke-width: 7; stroke-linecap: round; transition: stroke-dasharray 1s; }\n    .mid { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; line-height:1.05; }\n    .k { font-size: 9px; letter-spacing: 1.4px; color: #8b8f8b; font-weight: 800; }\n    .av { font-size: 30px; font-weight: 800; } .ac { font-size: 11.5px; font-weight: 800; color: #ececec; }\n    .c { background: rgba(255,255,255,.04); border-radius: 9px; padding: 4px 2px; text-align:center; }\n    .c span { display:block; font-size: 8.5px; letter-spacing: 1px; color: #8b8f8b; font-weight: 800; }\n    .c b { font-size: 12px; color: #ececec; font-weight: 800; }"
                          }
