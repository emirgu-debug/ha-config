                        "l1": "[[[ return '<div class=\"sec\">OSCILLATION</div>'; ]]]",
                        "l2": "[[[ const h = states['humidifier.dyson_x6p_eu_thb1395a']; return '<div class=\"sec\">NIGHT · HUMIDITY ' + (h.state === 'on' ? '(target ' + (h.attributes.humidity ?? '—') + '%)' : '(off)') + '</div>'; ]]]",
                        "l3": "[[[ return '<div class=\"sec\">SLEEP TIMER</div>'; ]]]",
                        "l4": "[[[ return '<div class=\"sec\">POWER</div>'; ]]]",
                        "pl": {
                          "card": {
