                        "sw": {
                          "card": {
                            "type": "custom:button-card",
                            "name": "Swing",
                            "icon": "mdi:arrow-oscillating",
                            "show_icon": true,
                            "show_name": true,
                            "show_state": false,
                            "tap_action": {
                              "action": "perform-action",
                              "perform_action": "script.am07_swing",
                              "haptic": "light"
                            },
                            "hold_action": {
                              "action": "none"
                            },
                            "styles": {
                              "card": [
                                {
                                  "border": "none"
                                },
                                {
                                  "box-shadow": "none"
                                },
                                {
                                  "padding": "8px 2px"
                                },
                                {
                                  "border-radius": "12px"
                                },
                                {
                                  "font-family": "'Nunito', 'Roboto', sans-serif"
                                },
                                {
                                  "transition": "transform .12s ease, background .2s ease, box-shadow .3s ease"
                                },
                                {
                                  "background": "[[[ return states['input_boolean.am07_swing_acik'].state === 'on' ? 'rgba(111,208,242,.18)' : 'rgba(255,255,255,.05)'; ]]]"
                                },
                                {
                                  "box-shadow": "[[[ const ts = (states['input_datetime.am07_son_komut'].attributes.timestamp || 0) * 1000; const fresh = Date.now() - ts < 6000;\n     if (fresh) return '0 0 0 2px rgba(142,224,92,.75), 0 0 18px rgba(142,224,92,.55)';\n     return states['input_boolean.am07_swing_acik'].state === 'on' ? 'inset 0 0 0 1px rgba(111,208,242,.5)' : 'none'; ]]]"
                                },
                                {
                                  "opacity": "[[[ return (states['binary_sensor.ikinci_priz_am07_calisiyor'].state === 'on') ? '1' : '.35'; ]]]"
                                }
                              ],
                              "icon": [
                                {
                                  "width": "22px"
                                },
                                {
                                  "height": "22px"
                                },
                                {
                                  "color": "[[[ return states['input_boolean.am07_swing_acik'].state === 'on' ? '#6fd0f2' : '#8b8f8b'; ]]]"
                                },
                                {
                                  "animation": "[[[ return states['input_boolean.am07_swing_acik'].state === 'on' ? 'swingrock 2.6s ease-in-out infinite' : 'none'; ]]]"
                                }
                              ],
                              "name": [
                                {
                                  "font-size": "12.5px"
                                },
                                {
                                  "font-weight": "800"
                                },
                                {
                                  "color": "[[[ return states['input_boolean.am07_swing_acik'].state === 'on' ? '#d5f5c5' : '#c9d0dc'; ]]]"
                                }
                              ],
                              "grid": [
                                {
                                  "grid-template-areas": "\"i\" \"n\" \"tag\""
                                },
                                {
                                  "row-gap": "2px"
                                }
                              ],
                              "custom_fields": {
                                "tag": [
                                  {
                                    "min-height": "11px"
                                  }
                                ]
                              }
                            },
                            "extra_styles": "#card:active { transform: scale(.9); }\n  @keyframes swingrock { 0%,100% { transform: rotate(-22deg); } 50% { transform: rotate(22deg); } }\n  @keyframes sentflash { 0% { opacity: 0; transform: translateY(2px); } 15% { opacity: 1; transform: none; } 70% { opacity: 1; } 100% { opacity: 0; } }\n  .sent { font-size: 8.5px; font-weight: 800; letter-spacing: 1px; color: #a6ea7c; animation: sentflash 6s ease forwards; }\n  .asm { font-size: 8.5px; font-weight: 800; letter-spacing: .6px; color: #8b8f8b; }",
                            "custom_fields": {
                              "tag": "[[[ const lit = states['input_boolean.am07_swing_acik'].state === 'on';\n  const ts = (states['input_datetime.am07_son_komut'].attributes.timestamp || 0) * 1000;\n  const fresh = Date.now() - ts < 6000;\n  return (fresh ? '<span class=\"sent\">SENT</span>' : (lit ? '<span class=\"asm\">assumed on</span>' : '')); ]]]"
                            }
                          }
                        },
                        "spd": "[[[ const run = states['binary_sensor.ikinci_priz_am07_calisiyor'].state === 'on';\n  const mRaw = parseInt(states['sensor.am07_olculen_hiz'].state), m = isNaN(mRaw) ? 0 : mRaw;\n  const cmd = parseInt(states['input_number.am07_hiz'].state) || 1;\n  const age = (Date.now() - Date.parse(states['input_number.am07_hiz'].last_changed)) / 1000;\n  const pending = run && cmd !== m && age < 45;\n  const show = pending ? cmd : (m || cmd);\n  let segs = ''; for (let i = 1; i <= 10; i++) { let cl = 'sg';\n    if (run && i <= Math.min(m, show)) cl += ' on'; else if (pending && i <= show) cl += ' pend';\n    segs += '<i class=\"' + cl + '\"></i>'; }\n  return '<div class=\"sl\">SPEED' + (pending ? '<b class=\"pd\">•</b>' : '') + '</div>'\n    + '<div class=\"sv' + (run ? (pending ? ' pend' : '') : ' dim') + '\">' + (run ? show : '–') + '<small>/10</small></div>'\n    + '<div class=\"segs\">' + segs + '</div>'\n    + '<div class=\"sn\">' + (run ? (pending ? 'sending…' : 'measured') : '') + '</div>'; ]]]"
                      },
                      "styles": {
                        "card": [
                          {
                            "background": "#252625"
                          },
                          {
                            "border": "none"
                          },
                          {
                            "border-radius": "22px"
                          },
                          {
                            "padding": "12px"
                          },
                          {
                            "margin-top": "10px"
                          },
                          {
                            "font-family": "'Nunito', 'Roboto', sans-serif"
                          },
                          {
                            "box-shadow": "[[[ return states['binary_sensor.ikinci_priz_am07_calisiyor'].state === 'on' ? '0 0 0 1px rgba(111,208,242,.22), 0 14px 36px -14px rgba(111,208,242,.35)' : 'none'; ]]]"
                          }
                        ],
                        "grid": [
                          {
                            "grid-template-areas": "\"hdr hdr hdr hdr hdr\" \"st st st spd spd\" \"pw sd su sw sw\""
                          },
                          {
                            "grid-template-columns": "repeat(5, 1fr)"
                          },
                          {
                            "row-gap": "8px"
                          },
                          {
                            "column-gap": "6px"
                          }
                        ],
                        "custom_fields": {
                          "st": [
                            {
                              "align-self": "center"
                            }
                          ],
                          "spd": [
                            {
                              "align-self": "center"
                            },
                            {
                              "min-width": "0"
                            }
                          ]
                        }
                      },
                      "extra_styles": ".hl { font-size: 17px; font-weight: 800; color: #d5f5c5; text-align: center; }\n    .hr { display:flex; gap: 6px; flex-wrap: wrap; justify-content: center; margin-top: 4px; }\n    .ch { font-size: 10px; font-weight: 800; letter-spacing: .6px; padding: 3px 8px; border-radius: 99px; background: rgba(255,255,255,.06); color: #8b8f8b; }\n    .ch.on { background: rgba(111,208,242,.16); color: #9fe2ff; }\n    .ch.bad { background: rgba(224,119,111,.18); color: #ffab9f; } .ch.warn { background: rgba(231,183,95,.16); color: #f1cf8d; }\n    \n  .sl { font-size: 9.5px; font-weight: 800; letter-spacing: 1.3px; color: #8b8f8b; text-align: center; }\n  .sv { font-size: 40px; font-weight: 800; color: #ececec; line-height: 1; text-align: center; } .sv.dim { color: #5d605d; }\n  .sv small { font-size: 13px; color: #8b8f8b; margin-left: 2px; }\n  .segs { display: flex; gap: 3px; justify-content: center; margin-top: 6px; }\n  .sg { width: 7px; height: 16px; border-radius: 3px; background: rgba(255,255,255,.08); display: inline-block; transition: background .3s ease; }\n  .sg.on { background: linear-gradient(180deg, #8ee05c, #6fd0f2); box-shadow: 0 0 8px rgba(142,224,92,.35); }\n  .sg.pend { background: rgba(231,183,95,.45); box-shadow: 0 0 8px rgba(231,183,95,.3); animation: am07pend 1s ease-in-out infinite; }\n  .sv.pend { color: #f1cf8d; }\n  .pd { color: #f1cf8d; margin-left: 4px; animation: am07pend 1s ease-in-out infinite; }\n  .sn { font-size: 8.5px; font-weight: 800; letter-spacing: 1px; color: #6f736f; text-align: center; margin-top: 5px; text-transform: uppercase; }\n  @keyframes am07pend { 0%,100% { opacity: 1; } 50% { opacity: .35; } }"
                    }
                  ]
                }
              ]
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "vertical-stack",
                  "cards": [
                    {
                      "type": "custom:button-card",
                      "entity": "input_datetime.oda_klima_son_komut",
                      "triggers_update": [
                        "input_datetime.oda_klima_son_komut"
                      ],
                      "show_icon": false,
                      "show_state": false,
                      "name": "Oda Aircon",
                      "tap_action": {
                        "action": "none"
