                            },
                            "extra_styles": "#card { transition: transform .12s ease, background .2s ease; } #card:active { transform: scale(.9); }\n  @keyframes acspin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }\n  @keyframes acpulse { 0%,100% { opacity: .55; } 50% { opacity: 1; } }\n      .fi { --mdc-icon-size: 18px; color: #8ee05c; display: inline-flex; }\n      .bars { display: inline-flex; align-items: flex-end; gap: 3px; height: 22px; }\n      .b { width: 5px; border-radius: 2px; background: #3b3e3b; display: inline-block; }\n      .b.on { background: #8ee05c; } .b.auto { animation: acpulse 1.6s ease-in-out infinite; }\n      .fl { font-size: 12px; font-weight: 800; color: #ececec; letter-spacing: .6px; min-width: 44px; text-align: left; }\n      .off { color: #8b8f8b; } .on { color: #6fd0f2; } .since { color: #8b8f8b; font-weight: 700; letter-spacing: .4px; }"
                          }
                        },
                        "dl": {
                          "card": {
                            "type": "custom:button-card",
                            "entity": "sensor.salon_termo_temperature",
                            "show_name": false,
                            "show_icon": false,
                            "show_state": false,
                            "tap_action": {
                              "action": "more-info"
                            },
                            "custom_fields": {
                              "d": "[[[ const rt=parseFloat(states['sensor.salon_termo_temperature']?.state), rh=parseFloat(states['sensor.salon_termo_humidity']?.state), sp=parseInt(states['input_number.salon_klima_sicaklik'].state);\n        const on=states['input_select.salon_klima_mod'].state!=='off';\n        const MIN=16, MAX=32, R=62, cx=80, cy=80, A0=135, SW=270;\n        const ang=(v)=>A0+SW*Math.max(0,Math.min(1,(v-MIN)/(MAX-MIN)));\n        const pt=(a,r)=>{const q=a*Math.PI/180; return [cx+(r||R)*Math.cos(q), cy+(r||R)*Math.sin(q)];};\n        const arc=(a0,a1)=>{ if(a1<a0){const t=a0;a0=a1;a1=t;} const p0=pt(a0),p1=pt(a1);\n          return 'M '+p0[0].toFixed(2)+' '+p0[1].toFixed(2)+' A '+R+' '+R+' 0 '+((a1-a0)>180?1:0)+' 1 '+p1[0].toFixed(2)+' '+p1[1].toFixed(2); };\n        let seg='', knobR='', knobS='';\n        if (!isNaN(sp)) { const ps=pt(ang(sp)); knobS='<circle cx=\"'+ps[0].toFixed(2)+'\" cy=\"'+ps[1].toFixed(2)+'\" r=\"7.5\" fill=\"#d5f5c5\" stroke=\"#2d2e2d\" stroke-width=\"3\"/>'; }\n        if (!isNaN(rt)) { const pr=pt(ang(rt)); knobR='<circle cx=\"'+pr[0].toFixed(2)+'\" cy=\"'+pr[1].toFixed(2)+'\" r=\"4.5\" fill=\"#fff\"/>'; }\n        if (!isNaN(rt) && !isNaN(sp)) { const col = !on ? '#4a4d4a' : (rt>sp ? '#6fd0f2' : '#e0776f');\n          seg='<path d=\"'+arc(ang(rt),ang(sp))+'\" stroke=\"'+col+'\" stroke-width=\"8\" fill=\"none\" stroke-linecap=\"round\" opacity=\"'+(on?1:.8)+'\"/>'; }\n        const ticks=[18,22,26,30].map(v=>{const a=pt(ang(v),R+12);return '<text x=\"'+a[0].toFixed(1)+'\" y=\"'+(a[1]+3).toFixed(1)+'\" class=\"tk\">'+v+'</text>';}).join('');\n        const diff = (!isNaN(rt)&&!isNaN(sp)) ? (rt-sp) : NaN;\n        return '<svg viewBox=\"-8 -8 176 176\" class=\"ring\"><path d=\"'+arc(A0,A0+SW)+'\" stroke=\"#101110\" stroke-width=\"8\" fill=\"none\" stroke-linecap=\"round\"/>'\n          + seg + knobR + knobS + ticks + '</svg>'\n          + '<div class=\"mid\"><div class=\"k\">ROOM</div><div class=\"rt\">'+(isNaN(rt)?'N/A':rt.toFixed(1)+'<sup>°C</sup>')+'</div>'\n          + '<div class=\"rh\">'+(isNaN(rh)?'':Math.round(rh)+'% RH')+'</div>'\n          + '<div class=\"sp\"><span class=\"k2\">SET</span> '+(isNaN(sp)?'--':sp+'°')+'</div>'\n          + '<div class=\"df\">'+(isNaN(diff)?'':(diff>0?'▲ ':'▼ ')+Math.abs(diff).toFixed(1)+'°')+'</div></div>'; ]]]"
                            },
                            "styles": {
                              "card": [
                                {
                                  "background": "#2d2e2d"
                                },
                                {
                                  "border": "none"
                                },
                                {
                                  "border-radius": "20px"
                                },
                                {
                                  "padding": "4px"
                                },
                                {
                                  "box-shadow": "0 8px 18px rgba(0,0,0,.35)"
                                },
                                {
                                  "font-family": "'Nunito', 'Roboto', sans-serif"
                                }
                              ],
                              "grid": [
                                {
                                  "grid-template-areas": "\"d\""
                                },
                                {
                                  "grid-template-columns": "1fr"
                                }
                              ],
                              "custom_fields": {
                                "d": [
                                  {
                                    "position": "relative"
                                  },
                                  {
                                    "width": "100%"
                                  },
                                  {
                                    "aspect-ratio": "1 / 1"
                                  }
                                ]
                              }
                            },
                            "extra_styles": ".ring { position:absolute; inset:0; width:100%; height:100%; overflow: visible; }\n      .tk { fill: #8b8f8b; font-size: 8px; font-weight: 700; text-anchor: middle; font-family: 'Nunito', 'Roboto', sans-serif; }\n      .mid { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; color:#ececec; line-height:1.1; }\n      .k { font-size: 9px; letter-spacing: 1.4px; color:#8b8f8b; font-weight:800; }\n      .rt { font-size: 30px; font-weight: 800; } .rt sup { font-size: 12px; margin-left: 1px; }\n      .rh { font-size: 12px; color: #b8bcb8; font-weight: 700; margin-top: 1px; }\n      .sp { font-size: 15px; font-weight: 800; color: #d5f5c5; margin-top: 6px; } .k2 { font-size: 9px; letter-spacing: 1.2px; color: #8b8f8b; }\n      .df { font-size: 10px; color: #8b8f8b; font-weight: 700; min-height: 12px; }"
                          }
                        },
