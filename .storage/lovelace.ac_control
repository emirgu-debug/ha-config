                            }
                          ]
                        }
                      }
                    }
                  },
                  "styles": {
                    "card": [
                      {
                        "background": "[[[ \n  const w = states['weather.forecast_home'], cond = w ? w.state : 'cloudy';\n  const el = Number(states['sun.sun']?.attributes?.elevation ?? 30);\n  const over = ['cloudy','rainy','pouring','fog','snowy','snowy-rainy','hail','lightning','lightning-rainy','exceptional'].includes(cond);\n  const part = cond === 'partlycloudy' || cond === 'windy-variant';\n  const tod = el < -6 ? 'night' : (el < -2 ? 'blue' : (el < 8 ? 'gold' : 'day'));\n\n  const P = over\n    ? { night: ['#12151c','#262b36'], blue: ['#1c2230','#3a4254'], gold: ['#3a3f4a','#6d6a6a'], day: ['#56687c','#93a2b2'] }\n    : { night: ['#070b1f','#18214a'], blue: ['#162457','#4d5f9c'], gold: ['#2e3f78','#e2906c'], day: ['#2c6cc4','#86bdf0'] };\n  const c = P[tod];\n  return 'linear-gradient(170deg, ' + c[0] + ' 0%, ' + c[1] + ' 100%)'; ]]]"
                      },
                      {
                        "border": "none"
                      },
                      {
                        "border-radius": "20px"
                      },
                      {
                        "padding": "14px 16px"
                      },
                      {
                        "box-shadow": "0 10px 30px -12px rgba(0,0,0,.6)"
                      },
                      {
