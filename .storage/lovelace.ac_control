                        "l1": "[[[ return '<div class=\"sec\">OSCILLATION</div>'; ]]]",
                        "l2": "[[[ const h = states['humidifier.dyson_x6p_eu_thb1395a']; return '<div class=\"sec\">NIGHT · HUMIDITY ' + (h.state === 'on' ? '(target ' + (h.attributes.humidity ?? '—') + '%)' : '(off)') + '</div>'; ]]]",
                        "l3": "[[[ return '<div class=\"sec\">SLEEP TIMER</div>'; ]]]",
                        "l4": "[[[ return '<div class=\"sec\">POWER</div>'; ]]]",
                        "pl": {
                          "card": {
                            "type": "custom:button-card",
                            "name": "Plug",
                            "icon": "mdi:power-plug",
                            "show_icon": true,
                            "show_name": true,
                            "show_state": false,
                            "tap_action": {
                              "action": "perform-action",
                              "perform_action": "switch.toggle",
                              "target": {
                                "entity_id": "switch.ikinci_priz"
                              },
                              "haptic": "medium"
                            },
                            "hold_action": {
                              "action": "none"
                            },
                            "custom_fields": {
                              "tag": "[[[ return states['switch.ikinci_priz'].state === 'on' ? '<span class=\"pt on\">mains on</span>' : '<span class=\"pt off\">mains cut</span>'; ]]]"
                            },
                            "styles": {
                              "card": [
