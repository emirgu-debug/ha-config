                        "sp": "[[[ \n    const K='salon', room='sensor.salon_termo_temperature', mode='input_select.salon_klima_mod';\n    window.__acHist = window.__acHist || {};\n    const draw = (h) => {\n      const now=Date.now()/1000, t0=now-86400, W=300, H=48;\n      const pts=(h[room]||[]).map(p=>[p.lu, parseFloat(p.s)]).filter(p=>!isNaN(p[1]));\n      const live=parseFloat(states[room]?.state); if(!isNaN(live)) pts.push([now, live]);\n      if (pts.length<2) return '<div class=\"sp-empty\">24h history loading…</div>';\n      let lo=Math.min(...pts.map(p=>p[1])), hi=Math.max(...pts.map(p=>p[1])); if(hi-lo<1){hi+=.5;lo-=.5;}\n      const X=(t)=>((Math.max(t,t0)-t0)/86400*W).toFixed(1), Y=(v)=>(H-4-(v-lo)/(hi-lo)*(H-8)).toFixed(1);\n      let d='M '+X(pts[0][0])+' '+Y(pts[0][1]); for(const p of pts.slice(1)) d+=' L '+X(p[0])+' '+Y(p[1]);\n      const ms=(h[mode]||[]).map(p=>[p.lu,p.s]); ms.push([now, states[mode].state]);\n      let rects=''; for(let i=0;i<ms.length-1;i++){ if(ms[i][1]!=='off'){ const a=X(ms[i][0]), b=X(ms[i+1][0]);\n        rects+='<rect x=\"'+a+'\" y=\"0\" width=\"'+Math.max(1,b-a).toFixed(1)+'\" height=\"'+H+'\" fill=\"rgba(111,208,242,.14)\"/>'; } }\n      return '<div class=\"sp-h\"><span>24H ROOM</span><span>'+lo.toFixed(1)+'° – '+hi.toFixed(1)+'°</span></div>'\n        + '<svg viewBox=\"0 0 300 48\" preserveAspectRatio=\"none\" class=\"sp-svg\">'+rects\n        + '<path d=\"'+d+'\" fill=\"none\" stroke=\"#d5f5c5\" stroke-width=\"1.6\" vector-effect=\"non-scaling-stroke\" stroke-linejoin=\"round\"/></svg>'\n        + '<div class=\"sp-f\"><span>-24h</span><span class=\"lg\"><i></i>AC on</span><span>now</span></div>';\n    };\n    const c = window.__acHist[K];\n    if (!c || Date.now()-c.at > 300000) {\n      if (!c || !c.loading) {\n        window.__acHist[K] = Object.assign(c||{}, {loading:true});\n        hass.callWS({type:'history/history_during_period', start_time:new Date(Date.now()-86400e3).toISOString(),\n          entity_ids:[room, mode], minimal_response:true, no_attributes:true, significant_changes_only:false})\n        .then(h => { window.__acHist[K] = {at:Date.now(), h, loading:false};\n          const el=this.shadowRoot && this.shadowRoot.querySelector('#spark_salon'); if (el) el.innerHTML = draw(h); })\n        .catch(() => { window.__acHist[K] = {at:Date.now(), h:{}, loading:false}; });\n      }\n    }\n    return '<div id=\"spark_salon\">' + draw((window.__acHist[K]&&window.__acHist[K].h)||{}) + '</div>'; ]]]"
                      },
                      "styles": {
                        "card": [
                          {
                            "background": "#252625"
                          },
                          {
                            "border": "none"
                          },
                          {
                            "border-radius": "0 0 22px 22px"
                          },
                          {
                            "padding": "14px 12px 12px"
                          },
                          {
                            "font-family": "'Nunito', 'Roboto', sans-serif"
                          },
                          {
                            "transition": "box-shadow .6s ease"
                          },
                          {
                            "box-shadow": "[[[ return entity.state!=='off' ? '0 0 0 1px rgba(111,208,242,.28), 0 14px 40px -12px rgba(111,208,242,.45)' : 'none'; ]]]"
                          }
                        ],
                        "grid": [
                          {
                            "grid-template-areas": "\"st st st dl dl dl\" \"su su cu cu hu hu\" \"sl sl cl cl hl hl\" \"sd sd cd cd hd hd\" \"sp sp sp sp sp sp\""
                          },
                          {
                            "grid-template-columns": "repeat(6, 1fr)"
                          },
                          {
                            "row-gap": "4px"
                          },
                          {
                            "column-gap": "6px"
                          }
                        ],
                        "custom_fields": {
                          "st": [
                            {
                              "align-self": "center"
                            }
                          ],
                          "dl": [
                            {
                              "align-self": "center"
                            },
                            {
                              "margin-bottom": "10px"
                            }
                          ],
                          "sp": [
                            {
                              "margin-top": "8px"
                            },
                            {
                              "min-width": "0"
                            }
                          ]
                        }
                      },
                      "extra_styles": ".sp-h, .sp-f { display:flex; justify-content:space-between; font-size: 9.5px; font-weight: 800; letter-spacing: 1.1px; color: #8b8f8b; }\n      .sp-svg { width: 100%; height: 48px; display:block; margin: 4px 0 3px; background: rgba(0,0,0,.18); border-radius: 8px; }\n      .sp-f { font-size: 9px; } .lg i { display:inline-block; width:9px; height:9px; border-radius:2px; background: rgba(111,208,242,.35); margin-right:4px; vertical-align: -1px; }\n      .sp-empty { font-size: 11px; color: #8b8f8b; text-align:center; padding: 18px 0; }"
                    },
