                      "extra_styles": ".sent { font-size: 11px; font-weight: 800; letter-spacing: 1.2px; color: #8ee05c; background: rgba(142,224,92,.12);\n        padding: 4px 9px; border-radius: 99px; animation: acfade 4.5s ease forwards; }\n      @keyframes acfade { 0% { opacity: 0; transform: translateY(3px); } 10% { opacity: 1; transform: none; } 75% { opacity: 1; } 100% { opacity: 0; } }"
                    },
                    {
                      "type": "custom:button-card",
                      "entity": "input_select.salon_klima_mod",
                      "show_icon": false,
                      "show_name": false,
                      "show_state": false,
                      "triggers_update": [
                        "input_number.salon_klima_sicaklik",
                        "input_select.salon_klima_fan_hizi",
                        "input_select.salon_klima_mod",
                        "sensor.salon_termo_temperature",
                        "sensor.salon_termo_humidity"
                      ],
                      "tap_action": {
                        "action": "none"
                      },
                      "custom_fields": {
                        "st": {
                          "card": {
                            "type": "custom:button-card",
                            "entity": "input_select.salon_klima_mod",
                            "show_name": false,
                            "show_state": false,
                            "icon": "[[[ return entity.state==='cool' ? 'mdi:snowflake' : (entity.state==='heat' ? 'mdi:white-balance-sunny' : 'mdi:power'); ]]]",
                            "tap_action": {
                              "action": "perform-action",
                              "haptic": "medium",
                              "perform_action": "[[[ return entity.state==='off' ? 'script.ac_apply_state' : 'script.ac_turn_off'; ]]]",
                              "data": {
                                "unit": "salon",
                                "temp": "[[[ return parseInt(states['input_number.salon_klima_sicaklik'].state)||24; ]]]",
                                "fan": "[[[ return states['input_select.salon_klima_fan_hizi'].state; ]]]"
                              }
                            },
                            "hold_action": {
                              "action": "perform-action",
                              "haptic": "heavy",
                              "perform_action": "[[[ return entity.state==='off' ? 'script.ac_turn_off' : 'script.ac_apply_state'; ]]]",
                              "data": {
                                "unit": "salon",
                                "temp": "[[[ return parseInt(states['input_number.salon_klima_sicaklik'].state)||24; ]]]",
                                "fan": "[[[ return states['input_select.salon_klima_fan_hizi'].state; ]]]"
                              }
                            },
                            "custom_fields": {
                              "fan": "[[[ const f=states['input_select.salon_klima_fan_hizi'].state, on=entity.state!=='off';\n        const lvl = f==='auto' ? 5 : (parseInt(f)||0);\n        const dur = f==='auto' ? 1.1 : ({1:2.6,2:2.0,3:1.4,4:0.9,5:0.55}[f]||1.5);\n        let bars=''; for (let i=1;i<=5;i++){ const h=6+i*3; const lit = on && (f==='auto' || i<=lvl);\n          bars += '<i class=\"b '+(lit?'on':'')+(f==='auto'&&on?' auto':'')+'\" style=\"height:'+h+'px\"></i>'; }\n        const spin = on ? 'animation: acspin '+dur+'s linear infinite;' : '';\n        return '<ha-icon icon=\"mdi:fan\" class=\"fi\" style=\"'+spin+'\"></ha-icon><span class=\"bars\">'+bars+'</span>'\n          + '<span class=\"fl\">'+(f==='auto'?'AUTO':'FAN '+f)+'</span>'; ]]]",
                              "stat": "[[[ if (entity.state==='off') return '<span class=\"off\">OFF</span>';\n        const d=new Date(entity.last_changed); const hh=String(d.getHours()).padStart(2,'0'), mm=String(d.getMinutes()).padStart(2,'0');\n        return '<span class=\"on\">'+(entity.state==='cool'?'COOLING':entity.state.toUpperCase())+'</span><span class=\"since\"> · since '+hh+':'+mm+'</span>'; ]]]"
                            },
                            "styles": {
                              "card": [
                                {
                                  "background": "none"
                                },
                                {
                                  "box-shadow": "none"
                                },
                                {
                                  "border": "none"
                                },
                                {
                                  "padding": "2px 0 0"
                                },
                                {
                                  "overflow": "visible"
                                },
                                {
                                  "font-family": "'Nunito', 'Roboto', sans-serif"
                                }
                              ],
                              "grid": [
                                {
                                  "grid-template-areas": "\"i\" \"fan\" \"stat\""
                                },
                                {
                                  "grid-template-rows": "1fr min-content min-content"
                                },
                                {
                                  "row-gap": "6px"
                                }
                              ],
                              "icon": [
                                {
                                  "width": "112px"
                                },
                                {
                                  "height": "112px"
                                },
                                {
                                  "color": "[[[ return entity.state==='cool' ? '#6fd0f2' : (entity.state==='heat' ? '#e0776f' : '#5d605d'); ]]]"
                                },
                                {
                                  "animation": "[[[ return entity.state==='cool' ? 'acspin 16s linear infinite' : 'none'; ]]]"
                                },
                                {
                                  "filter": "[[[ return entity.state==='off' ? 'none' : 'drop-shadow(0 0 16px rgba(111,208,242,.35))'; ]]]"
                                }
                              ],
                              "custom_fields": {
