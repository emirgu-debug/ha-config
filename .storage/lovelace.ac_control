                                },
                                {
                                  "font-weight": "800"
                                },
                                {
                                  "color": "[[[ return (states['binary_sensor.ikinci_priz_am07_calisiyor'].state === 'on') ? '#d5f5c5' : '#c9d0dc'; ]]]"
                                }
                              ],
                              "grid": [
                                {
                                  "grid-template-areas": "\"i\" \"n\""
                                },
                                {
                                  "row-gap": "2px"
                                }
                              ]
                            },
                            "extra_styles": "#card:active { transform: scale(.9); }"
                          }
                        },
                        "sd": {
