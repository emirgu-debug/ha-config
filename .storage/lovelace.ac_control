                      "custom_fields": {
                        "sent": "[[[ const ts=(entity.attributes.timestamp||0)*1000; const age=Date.now()-ts;\n        if (age>6000) return '';\n        return '<span class=\"sent\">&#10003; SENT</span>'; ]]]"
                      },
                      "styles": {
                        "card": [
                          {
                            "background": "#1c1d1c"
                          },
                          {
                            "box-shadow": "none"
                          },
                          {
                            "border": "none"
                          },
                          {
                            "border-radius": "14px 14px 0 0"
