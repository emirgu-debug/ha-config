                    {
                      "type": "custom:button-card",
                      "entity": "binary_sensor.ikinci_priz_am07_calisiyor",
                      "show_icon": false,
                      "show_name": false,
                      "show_state": false,
                      "triggers_update": [
                        "binary_sensor.ikinci_priz_am07_calisiyor",
                        "switch.ikinci_priz",
                        "sun.sun",
                        "input_number.am07_hiz",
                        "input_boolean.am07_swing_acik",
                        "input_datetime.am07_son_komut",
                        "sensor.am07_olculen_hiz"
                      ],
                      "tap_action": {
                        "action": "none"
                      },
                      "custom_fields": {
                        "hdr": "[[[ const w = parseFloat(states['sensor.ikinci_priz_power'].state) || 0;\n  const run = states['binary_sensor.ikinci_priz_am07_calisiyor'].state === 'on', plug = states['switch.ikinci_priz'].state === 'on';\n  const age = (Date.now() - Date.parse(states['sensor.ikinci_priz_power'].last_updated)) / 60000;\n  let chips = !plug ? '<span class=\"ch bad\">Mains cut — IR buttons do nothing</span>'\n    : (run ? '<span class=\"ch on\">Running · ' + w.toFixed(1) + ' W</span>' : '<span class=\"ch\">Off · 0 W</span>');\n  if (plug && age > 180) chips += '<span class=\"ch warn\">plug quiet ' + Math.round(age / 60) + ' h</span>';\n  return '<div class=\"hl\">AM07 · tower fan</div><div class=\"hr\">' + chips + '</div>'; ]]]",
                        "st": {
                          "card": {
                            "type": "custom:button-card",
                            "entity": "binary_sensor.ikinci_priz_am07_calisiyor",
                            "show_name": false,
                            "show_state": false,
                            "icon": "mdi:fan",
                            "tap_action": {
                              "action": "perform-action",
                              "haptic": "medium",
                              "perform_action": "[[[ return states['binary_sensor.ikinci_priz_am07_calisiyor'].state === 'on' ? 'script.am07_turn_off' : 'script.am07_turn_on'; ]]]"
                            },
                            "custom_fields": {
                              "lbl": "[[[ const w = parseFloat(states['sensor.ikinci_priz_power'].state) || 0, run = states['binary_sensor.ikinci_priz_am07_calisiyor'].state === 'on';\n  const hhmm = (t) => new Date(t).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: hass.config.time_zone || 'Europe/Istanbul' });\n  return '<div class=\"pv\">' + (run ? 'ON' : 'OFF') + '</div>'\n    + '<div class=\"pm\">' + (run ? w.toFixed(1) + ' W' : 'tap to start') + '</div>'\n    + '<div class=\"ps\">' + (run ? 'running' : 'off') + ' since ' + hhmm(Date.parse(entity.last_changed)) + '</div>'; ]]]"
                            },
                            "styles": {
                              "card": [
                                {
                                  "background": "none"
                                },
                                {
                                  "box-shadow": "none"
                                },
                                {
                                  "border": "none"
                                },
                                {
                                  "padding": "2px 0"
                                },
                                {
                                  "font-family": "'Nunito', 'Roboto', sans-serif"
                                },
                                {
                                  "transition": "transform .12s ease"
                                }
                              ],
                              "grid": [
                                {
                                  "grid-template-areas": "\"i\" \"lbl\""
                                },
                                {
                                  "row-gap": "4px"
                                }
                              ],
                              "icon": [
                                {
                                  "width": "74px"
                                },
                                {
                                  "height": "74px"
                                },
                                {
                                  "color": "[[[ return states['binary_sensor.ikinci_priz_am07_calisiyor'].state === 'on' ? '#6fd0f2' : '#5d605d'; ]]]"
                                },
                                {
                                  "animation": "[[[ const w = parseFloat(states['sensor.ikinci_priz_power'].state) || 0; if (!(states['binary_sensor.ikinci_priz_am07_calisiyor'].state === 'on')) return 'none'; return 'am07spin ' + Math.max(0.5, 2.6 - w / 14).toFixed(2) + 's linear infinite'; ]]]"
                                },
                                {
                                  "filter": "[[[ return states['binary_sensor.ikinci_priz_am07_calisiyor'].state === 'on' ? 'drop-shadow(0 0 14px rgba(111,208,242,.35))' : 'none'; ]]]"
                                }
                              ]
                            },
                            "extra_styles": "@keyframes am07spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }\n    #card:active { transform: scale(.94); }\n    .pv { font-size: 24px; font-weight: 800; color: #ececec; }\n    .pm { font-size: 10.5px; font-weight: 800; letter-spacing: .8px; color: #8b8f8b; }\n    .ps { font-size: 10px; font-weight: 700; color: #8b8f8b; margin-top: 1px; }"
                          }
                        },
                        "pw": {
                          "card": {
                            "type": "custom:button-card",
                            "name": "Power",
                            "icon": "mdi:power",
                            "show_icon": true,
                            "show_name": true,
                            "show_state": false,
                            "tap_action": {
                              "action": "perform-action",
                              "haptic": "medium",
                              "perform_action": "[[[ return states['binary_sensor.ikinci_priz_am07_calisiyor'].state === 'on' ? 'script.am07_turn_off' : 'script.am07_turn_on'; ]]]"
                            },
                            "hold_action": {
                              "action": "none"
                            },
                            "styles": {
                              "card": [
                                {
                                  "border": "none"
                                },
                                {
                                  "box-shadow": "none"
                                },
                                {
                                  "padding": "8px 2px"
                                },
                                {
                                  "border-radius": "12px"
                                },
                                {
                                  "font-family": "'Nunito', 'Roboto', sans-serif"
                                },
                                {
                                  "transition": "transform .12s ease, background .2s ease"
                                },
                                {
                                  "background": "[[[ return (states['binary_sensor.ikinci_priz_am07_calisiyor'].state === 'on') ? 'rgba(142,224,92,.16)' : 'rgba(255,255,255,.05)'; ]]]"
                                },
                                {
                                  "opacity": "[[[ return (true) ? '1' : '.35'; ]]]"
                                }
                              ],
                              "icon": [
                                {
                                  "width": "22px"
                                },
                                {
                                  "height": "22px"
                                },
                                {
                                  "color": "[[[ return (states['binary_sensor.ikinci_priz_am07_calisiyor'].state === 'on') ? '#8ee05c' : '#8b8f8b'; ]]]"
                                }
                              ],
                              "name": [
                                {
                                  "font-size": "12.5px"
                                },
                                {
                                  "font-weight": "800"
                                },
                                {
                                  "color": "[[[ return (states['binary_sensor.ikinci_priz_am07_calisiyor'].state === 'on') ? '#d5f5c5' : '#c9d0dc'; ]]]"
                                }
                              ],
                              "grid": [
                                {
                                  "grid-template-areas": "\"i\" \"n\""
                                },
                                {
                                  "row-gap": "2px"
                                }
                              ]
                            },
                            "extra_styles": "#card:active { transform: scale(.9); }"
                          }
