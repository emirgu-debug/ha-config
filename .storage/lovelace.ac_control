                          }
                        },
                        "pd": "[[[ const w = parseFloat(states['sensor.ikinci_priz_power'].state) || 0; const pct = Math.max(0, Math.min(100, w / 55 * 100));\n      return '<div class=\"wl\"><span>POWER DRAW</span><span>' + w.toFixed(1) + ' W</span></div>'\n        + '<div class=\"wt\"><div class=\"wf\" style=\"width:' + pct.toFixed(1) + '%\"></div></div>'\n        + '<div class=\"wn\">measured via smart plug (ikinci_priz)</div>'; ]]]"
                      },
                      "styles": {
                        "card": [
                          {
                            "background": "#252625"
                          },
                          {
                            "border": "none"
                          },
                          {
                            "border-radius": "22px"
                          },
                          {
                            "padding": "12px 12px 12px"
                          },
                          {
                            "box-shadow": "none"
                          },
                          {
                            "margin-top": "10px"
                          },
                          {
                            "font-family": "'Nunito', 'Roboto', sans-serif"
                          },
                          {
                            "box-shadow": "[[[ return states['fan.dyson_x6p_eu_thb1395a'].state === 'on' ? '0 0 0 1px rgba(111,208,242,.22), 0 14px 36px -14px rgba(111,208,242,.35)' : 'none'; ]]]"
                          },
                          {
                            "opacity": "[[[ const seen = Math.max(...['sensor.dyson_x6p_eu_thb1395a_air_quality_index', 'sensor.dyson_x6p_eu_thb1395a_temperature', 'sensor.dyson_x6p_eu_thb1395a_humidity', 'fan.dyson_x6p_eu_thb1395a'].map(e => states[e] ? Date.parse(states[e].last_updated) : 0)); return (Date.now() - seen) / 60000 > 30 ? '.55' : '1'; ]]]"
                          }
                        ],
                        "grid": [
                          {
                            "grid-template-areas": "\"hdr hdr hdr hdr\" \"st st aq aq\" \"fd fu au os\" \"l1 l1 l1 l1\" \"a1 a2 a3 a4\" \"l2 l2 l2 l2\" \"ni hm hd hu\" \"l3 l3 l3 l3\" \"s0 s1 s2 s3\" \"l4 l4 l4 l4\" \". pl pl .\" \"pd pd pd pd\""
                          },
                          {
                            "grid-template-columns": "repeat(4, 1fr)"
                          },
                          {
                            "row-gap": "6px"
                          },
                          {
                            "column-gap": "6px"
                          }
                        ],
                        "custom_fields": {
                          "st": [
                            {
                              "align-self": "center"
                            }
                          ],
                          "aq": [
                            {
                              "align-self": "center"
                            }
                          ],
                          "hdr": [
                            {
                              "margin-bottom": "2px"
                            }
                          ],
                          "pd": [
                            {
                              "align-self": "center"
                            },
                            {
                              "min-width": "0"
                            }
                          ]
                        }
                      },
                      "extra_styles": ".hl { font-size: 17px; font-weight: 800; color: #d5f5c5; }\n    .hr { display:flex; gap: 6px; flex-wrap: wrap; margin-top: 4px; justify-content: center; }\n    .ch { font-size: 10px; font-weight: 800; letter-spacing: .6px; padding: 3px 8px; border-radius: 99px; background: rgba(255,255,255,.06); color: #8b8f8b; }\n    .ch.on { background: rgba(111,208,242,.16); color: #9fe2ff; } .ch.hu { background: rgba(142,224,92,.14); color: #a6ea7c; } .ch.tm { background: rgba(231,183,95,.16); color: #f1cf8d; }\n    .sec { text-align: center; font-size: 9px; font-weight: 800; letter-spacing: 1.3px; color: #8b8f8b; margin: 4px 0 -2px; }\n    @media (prefers-reduced-motion: reduce) { * { animation: none !important; } }\n.pt { font-size: 8.5px; font-weight: 800; letter-spacing: .6px; }\n.pt.on { color: #8b8f8b; } .pt.off { color: #ffab9f; }\n@keyframes plugpulse { 0%,100% { opacity: 1; } 50% { opacity: .45; } }\n.wl { display:flex; justify-content: space-between; font-size: 9.5px; font-weight: 800; letter-spacing: 1.1px; color: #8b8f8b; }\n.wt { height: 9px; border-radius: 5px; background: rgba(255,255,255,.06); overflow: hidden; margin: 5px 0 4px; }\n.wf { height: 100%; border-radius: 5px; background: linear-gradient(90deg, #6fd0f2, #8ee05c); transition: width 1.2s ease; }\n.wn { font-size: 9px; font-weight: 700; color: #8b8f8b; line-height: 1.3; }"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Portrait",
          "path": "aircon-portrait",
          "icon": "mdi:crop-portrait",
          "type": "sections",
          "max_columns": 1,
          "background": "radial-gradient(ellipse at 15% -10%, #1d261f 0%, #131413 55%, #0f100f 100%)",
          "sections": [
            {
              "type": "grid",
              "column_span": 3,
              "cards": [
                {
                  "type": "custom:button-card",
                  "entity": "weather.forecast_home",
                  "show_icon": false,
                  "show_name": false,
                  "show_state": false,
                  "triggers_update": [
                    "weather.forecast_home",
                    "sun.sun",
                    "sensor.moon_phase",
                    "sensor.salon_termo_temperature",
                    "input_select.salon_klima_mod",
                    "sensor.oda_sicaklik_nem_ekransiz_temperature",
                    "input_select.oda_klima_mod",
                    "sensor.dyson_x6p_eu_thb1395a_temperature",
                    "input_select.leyla_klima_mod"
                  ],
                  "tap_action": {
                    "action": "none"
                  },
                  "grid_options": {
                    "columns": "full"
                  },
                  "custom_fields": {
                    "sky": "[[[ \n  const w = states['weather.forecast_home'], cond = w ? w.state : 'cloudy';\n  const el = Number(states['sun.sun']?.attributes?.elevation ?? 30);\n  const over = ['cloudy','rainy','pouring','fog','snowy','snowy-rainy','hail','lightning','lightning-rainy','exceptional'].includes(cond);\n  const part = cond === 'partlycloudy' || cond === 'windy-variant';\n  const tod = el < -6 ? 'night' : (el < -2 ? 'blue' : (el < 8 ? 'gold' : 'day'));\n\n  let s = 7; const rnd = () => (s = (s * 16807) % 2147483647) / 2147483647;\n  let h = '';\n  if ((tod === 'night' || tod === 'blue') && !over) {\n    for (let i = 0; i < 46; i++) {\n      const x = (rnd()*100).toFixed(1), y = (rnd()*78).toFixed(1), z = (rnd()*1.6+0.6).toFixed(1), d = (rnd()*5).toFixed(1), du = (2.5+rnd()*3).toFixed(1);\n      h += '<i class=\"star\" style=\"left:'+x+'%;top:'+y+'%;width:'+z+'px;height:'+z+'px;animation-delay:-'+d+'s;animation-duration:'+du+'s\"></i>';\n    }\n  }\n  if (tod === 'night' || tod === 'blue') {\n    const syn = 29.530588853, ref = Date.UTC(2000,0,6,18,14);\n    const ph = (((Date.now()-ref)/86400000) % syn + syn) % syn / syn;\n    const r = 13, k = Math.cos(2*Math.PI*ph), waxing = ph < .5;\n    const lit = (1-k)/2;\n    const rx = Math.abs(k) * r;\n    const outer = 'M 0 '+(-r)+' A '+r+' '+r+' 0 0 '+(waxing?1:0)+' 0 '+r;\n    const inner = ' A '+rx.toFixed(2)+' '+r+' 0 0 '+((k<0)===waxing?1:0)+' 0 '+(-r);\n    const op = over ? .35 : 1;\n    if (lit > .02) h += '<svg class=\"moon\" viewBox=\"-16 -16 32 32\" style=\"opacity:'+op+'\"><circle r=\"'+r+'\" fill=\"rgba(255,255,255,.07)\"/>'\n      + '<path d=\"'+outer+inner+'\" fill=\"#f3efd9\"/></svg>';\n  }\n  if ((tod === 'day' || tod === 'gold') && !over) h += '<i class=\"sun '+(tod==='gold'?'low':'')+'\"></i>';\n  const nC = over ? 5 : (part ? 3 : 0);\n  for (let i = 0; i < nC; i++) {\n    const y = (8 + rnd()*55).toFixed(0), sc = (0.7 + rnd()*0.9).toFixed(2), du = (70 + rnd()*80).toFixed(0), dl = (rnd()*100).toFixed(0);\n    const dark = over && (cond.includes('rain') || cond.includes('pouring') || cond.includes('lightning'));\n    h += '<i class=\"cloud '+(dark?'dark':'')+'\" style=\"top:'+y+'%;--sc:'+sc+';animation-duration:'+du+'s;animation-delay:-'+dl+'s\"></i>';\n  }\n  const nR = cond === 'pouring' ? 90 : ((cond === 'rainy' || cond === 'lightning-rainy' || cond === 'snowy-rainy' || cond === 'hail') ? 45 : 0);\n  for (let i = 0; i < nR; i++) {\n    const x = (rnd()*100).toFixed(1), du = (0.45 + rnd()*0.4).toFixed(2), dl = (rnd()*2).toFixed(2);\n    h += '<i class=\"rain\" style=\"left:'+x+'%;animation-duration:'+du+'s;animation-delay:-'+dl+'s\"></i>';\n  }\n  const nS = (cond === 'snowy' || cond === 'snowy-rainy') ? 40 : 0;\n  for (let i = 0; i < nS; i++) {\n    const x = (rnd()*100).toFixed(1), du = (4 + rnd()*4).toFixed(1), dl = (rnd()*8).toFixed(1), z = (2 + rnd()*2.5).toFixed(1);\n    h += '<i class=\"snow\" style=\"left:'+x+'%;width:'+z+'px;height:'+z+'px;animation-duration:'+du+'s;animation-delay:-'+dl+'s\"></i>';\n  }\n  if (cond === 'fog') for (let i = 0; i < 3; i++) h += '<i class=\"fog\" style=\"top:'+(18+i*26)+'%;animation-duration:'+(28+i*9)+'s;animation-delay:-'+(i*7)+'s\"></i>';\n  if (cond === 'windy' || cond === 'windy-variant') for (let i = 0; i < 6; i++) h += '<i class=\"gust\" style=\"top:'+(12+rnd()*70).toFixed(0)+'%;animation-duration:'+(2.2+rnd()*1.6).toFixed(1)+'s;animation-delay:-'+(rnd()*3).toFixed(1)+'s\"></i>';\n  if (cond.startsWith('lightning')) h += '<i class=\"flash\"></i>';\n  return h; ]]]",
                    "wx": "[[[ \n  const w=states['weather.forecast_home'], a=w.attributes;\n  const IC={'clear-night':'weather-night','sunny':'weather-sunny','partlycloudy':'weather-partly-cloudy','cloudy':'weather-cloudy','fog':'weather-fog',\n    'rainy':'weather-rainy','pouring':'weather-pouring','snowy':'weather-snowy','snowy-rainy':'weather-snowy-rainy','hail':'weather-hail',\n    'lightning':'weather-lightning','lightning-rainy':'weather-lightning-rainy','windy':'weather-windy','windy-variant':'weather-windy-variant','exceptional':'alert-circle-outline'};\n  const NM={'clear-night':'Clear','sunny':'Sunny','partlycloudy':'Partly cloudy','cloudy':'Cloudy','fog':'Fog','rainy':'Rain','pouring':'Heavy rain',\n    'snowy':'Snow','snowy-rainy':'Sleet','hail':'Hail','lightning':'Storm','lightning-rainy':'Storm','windy':'Windy','windy-variant':'Windy','exceptional':'Alert'};\n  window.__acWx = window.__acWx || {};\n  const hl = (f) => f ? '<span class=\"hl\">H '+Math.round(f.temperature)+'° · L '+Math.round(f.templow)+'°</span>' : '<span class=\"hl\">H/L …</span>';\n  const c = window.__acWx;\n  if (!c.at || Date.now()-c.at > 1800000) {\n    if (!c.loading) { c.loading = true;\n      hass.callWS({type:'call_service', domain:'weather', service:'get_forecasts', service_data:{type:'daily'}, target:{entity_id:'weather.forecast_home'}, return_response:true})\n        .then(r => { c.f = r.response['weather.forecast_home'].forecast[0]; c.at = Date.now(); c.loading = false;\n          const el = this.shadowRoot && this.shadowRoot.querySelector('#achl'); if (el) el.innerHTML = hl(c.f); })\n        .catch(() => { c.at = Date.now(); c.loading = false; });\n    }\n  }\n  const mp = states['sensor.moon_phase']?.state;\n  const MP = {new_moon:'New moon',waxing_crescent:'Waxing crescent',first_quarter:'First quarter',waxing_gibbous:'Waxing gibbous',full_moon:'Full moon',waning_gibbous:'Waning gibbous',last_quarter:'Last quarter',waning_crescent:'Waning crescent'};\n  return '<ha-icon icon=\"mdi:'+(IC[w.state]||'weather-cloudy')+'\" class=\"wi\"></ha-icon>'\n    + '<div class=\"wt\"><div class=\"wc\">'+(NM[w.state]||w.state)+(mp?' · '+(MP[mp]||mp):'')+'</div>'\n    + '<div class=\"wv\">'+Number(a.temperature).toFixed(1)+'<sup>°C</sup> <span class=\"wh\">'+a.humidity+'%</span></div>'\n    + '<div id=\"achl\">'+hl(c.f)+'</div></div>'; ]]]",
                    "rooms": "[[[ \n  return [{n:'Salon', t:'sensor.salon_termo_temperature', m:'input_select.salon_klima_mod'},{n:'Oda', t:'sensor.oda_sicaklik_nem_ekransiz_temperature', m:'input_select.oda_klima_mod'},{n:'Leyla', t:'sensor.dyson_x6p_eu_thb1395a_temperature', m:'input_select.leyla_klima_mod'}].map(r => { const t=parseFloat(states[r.t]?.state), m=states[r.m]?.state;\n    const on = m && m!=='off';\n    return '<div class=\"chip '+(on?'on':'')+'\"><ha-icon icon=\"'+(on?'mdi:snowflake':'mdi:power')+'\"></ha-icon>'\n      + '<span class=\"cn\">'+r.n+'</span><span class=\"ct\">'+(isNaN(t)?'N/A':t.toFixed(1)+'°')+'</span></div>'; }).join(''); ]]]",
                    "off": {
                      "card": {
                        "type": "custom:button-card",
                        "template": "ac_base",
                        "name": "All off",
                        "icon": "mdi:power",
                        "show_name": true,
                        "tap_action": {
                          "action": "perform-action",
                          "perform_action": "script.ac_all_off",
                          "haptic": "heavy",
                          "confirmation": {
                            "text": "Turn off all air conditioners?"
