                                },
                                {
                                  "transition": "transform .12s ease, background .2s ease"
                                },
                                {
                                  "background": "[[[ return (states['switch.ikinci_priz'].state === 'on') ? 'rgba(231,183,95,.14)' : 'rgba(224,119,111,.18)'; ]]]"
                                },
                                {
                                  "box-shadow": "[[[ return (states['switch.ikinci_priz'].state === 'on') ? 'none' : 'inset 0 0 0 1px rgba(224,119,111,.5)'; ]]]"
                                }
                              ],
                              "icon": [
                                {
                                  "width": "22px"
                                },
                                {
                                  "height": "22px"
                                },
                                {
                                  "color": "[[[ return (states['switch.ikinci_priz'].state === 'on') ? '#e7b75f' : '#e0776f'; ]]]"
                                },
                                {
                                  "animation": "[[[ return (states['switch.ikinci_priz'].state === 'on') ? 'none' : 'plugpulse 2s ease-in-out infinite'; ]]]"
                                }
                              ],
                              "name": [
                                {
                                  "font-size": "12.5px"
                                },
                                {
                                  "font-weight": "800"
                                },
                                {
                                  "color": "[[[ return (states['switch.ikinci_priz'].state === 'on') ? '#f1cf8d' : '#ffab9f'; ]]]"
                                }
                              ],
                              "grid": [
                                {
                                  "grid-template-areas": "\"i\" \"n\" \"tag\""
                                },
                                {
                                  "row-gap": "2px"
                                }
                              ],
                              "custom_fields": {
                                "tag": [
                                  {
                                    "min-height": "11px"
                                  }
                                ]
                              }
                            },
                            "extra_styles": "#card:active { transform: scale(.9); }"
                          }
                        },
                        "pd": "[[[ const w = parseFloat(states['sensor.ikinci_priz_power'].state) || 0; const pct = Math.max(0, Math.min(100, w / 55 * 100));\n      return '<div class=\"wl\"><span>POWER DRAW</span><span>' + w.toFixed(1) + ' W</span></div>'\n        + '<div class=\"wt\"><div class=\"wf\" style=\"width:' + pct.toFixed(1) + '%\"></div></div>'\n        + '<div class=\"wn\">measured via smart plug (ikinci_priz)</div>'; ]]]"
                      },
                      "styles": {
                        "card": [
                          {
                            "background": "#252625"
                          },
                          {
                            "border": "none"
                          },
                          {
                            "border-radius": "22px"
                          },
                          {
                            "padding": "12px 12px 12px"
                          },
                          {
                            "box-shadow": "none"
                          },
                          {
                            "margin-top": "10px"
                          },
                          {
                            "font-family": "'Nunito', 'Roboto', sans-serif"
                          },
                          {
                            "box-shadow": "[[[ return states['fan.dyson_x6p_eu_thb1395a'].state === 'on' ? '0 0 0 1px rgba(111,208,242,.22), 0 14px 36px -14px rgba(111,208,242,.35)' : 'none'; ]]]"
                          },
                          {
                            "opacity": "[[[ const seen = Math.max(...['sensor.dyson_x6p_eu_thb1395a_air_quality_index', 'sensor.dyson_x6p_eu_thb1395a_temperature', 'sensor.dyson_x6p_eu_thb1395a_humidity', 'fan.dyson_x6p_eu_thb1395a'].map(e => states[e] ? Date.parse(states[e].last_updated) : 0)); return (Date.now() - seen) / 60000 > 30 ? '.55' : '1'; ]]]"
                          }
                        ],
                        "grid": [
                          {
                            "grid-template-areas": "\"hdr hdr hdr hdr\" \"st st aq aq\" \"fd fu au os\" \"l1 l1 l1 l1\" \"a1 a2 a3 a4\" \"l2 l2 l2 l2\" \"ni hm hd hu\" \"l3 l3 l3 l3\" \"s0 s1 s2 s3\" \"l4 l4 l4 l4\" \". pl pl .\" \"pd pd pd pd\""
                          },
                          {
                            "grid-template-columns": "repeat(4, 1fr)"
                          },
                          {
                            "row-gap": "6px"
                          },
                          {
                            "column-gap": "6px"
                          }
                        ],
                        "custom_fields": {
                          "st": [
                            {
                              "align-self": "center"
                            }
                          ],
                          "aq": [
                            {
                              "align-self": "center"
                            }
                          ],
                          "hdr": [
                            {
                              "margin-bottom": "2px"
                            }
                          ],
                          "pd": [
                            {
                              "align-self": "center"
                            },
                            {
                              "min-width": "0"
                            }
                          ]
                        }
                      },
                      "extra_styles": ".hl { font-size: 17px; font-weight: 800; color: #d5f5c5; }\n    .hr { display:flex; gap: 6px; flex-wrap: wrap; margin-top: 4px; justify-content: center; }\n    .ch { font-size: 10px; font-weight: 800; letter-spacing: .6px; padding: 3px 8px; border-radius: 99px; background: rgba(255,255,255,.06); color: #8b8f8b; }\n    .ch.on { background: rgba(111,208,242,.16); color: #9fe2ff; } .ch.hu { background: rgba(142,224,92,.14); color: #a6ea7c; } .ch.tm { background: rgba(231,183,95,.16); color: #f1cf8d; }\n    .sec { text-align: center; font-size: 9px; font-weight: 800; letter-spacing: 1.3px; color: #8b8f8b; margin: 4px 0 -2px; }\n    @media (prefers-reduced-motion: reduce) { * { animation: none !important; } }\n.pt { font-size: 8.5px; font-weight: 800; letter-spacing: .6px; }\n.pt.on { color: #8b8f8b; } .pt.off { color: #ffab9f; }\n@keyframes plugpulse { 0%,100% { opacity: 1; } 50% { opacity: .45; } }\n.wl { display:flex; justify-content: space-between; font-size: 9.5px; font-weight: 800; letter-spacing: 1.1px; color: #8b8f8b; }\n.wt { height: 9px; border-radius: 5px; background: rgba(255,255,255,.06); overflow: hidden; margin: 5px 0 4px; }\n.wf { height: 100%; border-radius: 5px; background: linear-gradient(90deg, #6fd0f2, #8ee05c); transition: width 1.2s ease; }\n.wn { font-size: 9px; font-weight: 700; color: #8b8f8b; line-height: 1.3; }"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "button_card_templates": {
