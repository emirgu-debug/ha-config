                          {
                            "padding": "8px 12px 6px"
                          },
                          {
                            "overflow": "visible"
                          },
                          {
                            "font-family": "'Nunito', 'Roboto', sans-serif"
                          }
                        ],
                        "grid": [
                          {
                            "grid-template-areas": "\". n sent\""
                          },
                          {
                            "grid-template-columns": "1fr auto 1fr"
                          }
                        ],
                        "name": [
                          {
                            "color": "#d5f5c5"
                          },
                          {
                            "font-weight": "800"
                          },
                          {
                            "font-size": "29px"
                          },
                          {
                            "letter-spacing": ".3px"
                          }
                        ],
                        "custom_fields": {
                          "sent": [
                            {
                              "justify-self": "end"
                            },
                            {
                              "align-self": "center"
                            }
